---
import Layout from '../layouts/Layout.astro'
import Titlebar from '../components/Titlebar.astro'
import DepWarn from '../components/DepWarn.astro'
import LoginModal from '../components/LoginModal.astro'
import Footer from '../components/Footer.astro'
import SettingsView from '../components/SettingsView.astro'
import DiscoverView from '../components/DiscoverView.astro'
---

<Layout title="Live Paper">
  <Titlebar />
  <DepWarn />

  <div class="wails-no-drag flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <aside
      class="border-lp-border wails-drag flex w-56 shrink-0 flex-col border-r bg-[rgba(19,19,22,0.5)] backdrop-blur-[12px]"
    >
      <div class="wails-no-drag p-2.5 pb-1.5">
        <input
          class="border-lp-border text-lp-text placeholder:text-lp-muted h-[30px] w-full rounded-md border bg-white/[0.04] px-2.5 text-[11px] transition-[border-color,background-color] duration-150 outline-none focus:border-[rgba(47,138,239,0.5)] focus:bg-white/[0.06]"
          placeholder="Search library…"
          tabindex="-1"
          readonly
        />
      </div>

      <nav class="wails-no-drag flex flex-col gap-0.5 px-2">
        <!-- Displays — active/functional -->
        <button
          class="nav-item active flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
          data-view="displays"
        >
          <span class="nav-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path
                d="M12 17v4"></path>
            </svg>
          </span>
          Displays
          <span class="nav-dot"></span>
        </button>

        <!-- Discover — community wallpapers -->
        <button
          class="nav-item flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
          data-view="discover"
        >
          <span class="nav-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle><polygon
                points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </span>
          Discover
          <span class="nav-dot"></span>
        </button>

        <!-- Placeholder nav items -->
        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
        >
          <span class="text-lp-muted flex shrink-0 items-center">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="7" width="20" height="14" rx="2"></rect><path
                d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
            </svg>
          </span>
          Playlists
          <span
            class="text-lp-muted ml-auto shrink-0 rounded bg-white/[0.06] px-1.5 py-px text-[10px]"
            >—</span
          >
        </button>

        <!-- Library — downloaded wallpapers -->
        <button
          class="nav-item flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
          data-view="library"
        >
          <span class="nav-icon">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2"></rect><circle
                cx="8.5"
                cy="8.5"
                r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </span>
          Library
          <span class="nav-dot"></span>
        </button>

        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
        >
          <span class="text-lp-muted flex shrink-0 items-center">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              ></path>
            </svg>
          </span>
          Local Folders
        </button>
      </nav>

      <div
        class="text-lp-muted wails-drag px-[18px] pt-4 pb-1 text-[10px] font-semibold tracking-[0.12em] uppercase"
      >
        Collections
      </div>
      <div class="wails-no-drag flex flex-col gap-0.5 px-2">
        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
          ><span class="h-2 w-2 shrink-0 rounded-full" style="background:#34d399"
          ></span>Atmospheric</button
        >
        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
          ><span class="h-2 w-2 shrink-0 rounded-full" style="background:#a78bfa"
          ></span>Cyberpunk</button
        >
        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
          ><span class="h-2 w-2 shrink-0 rounded-full" style="background:#f472b6"
          ></span>Anime</button
        >
        <button
          class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
          tabindex="-1"
          title="Coming soon"
          aria-disabled="true"
          ><span class="h-2 w-2 shrink-0 rounded-full" style="background:#fbbf24"
          ></span>Nature</button
        >
      </div>

      <!-- User profile -->
      <div class="border-lp-border relative mt-auto border-t p-2.5" id="user-profile-section">
        <!-- Dropdown — opens upward, visible only when logged in -->
        <div
          id="user-dropdown"
          class="absolute right-2.5 bottom-[calc(100%+2px)] left-2.5 overflow-hidden rounded-lg border border-white/[0.08] bg-[#1c1c1f] shadow-[0_-8px_32px_rgba(0,0,0,0.6)]"
          hidden
        >
          <button
            id="dd-settings"
            class="flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-3 py-2.5 text-left text-[12px] text-white/70 transition-colors duration-[120ms] hover:bg-white/[0.06] hover:text-white/90"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
              ></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            Settings
          </button>
          <div class="mx-3 h-px bg-white/[0.06]"></div>
          <button
            id="dd-signout"
            class="flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-3 py-2.5 text-left text-[12px] text-white/70 transition-colors duration-[120ms] hover:bg-red-500/[0.08] hover:text-red-400"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Sign out
          </button>
        </div>

        <div
          id="user-profile-row"
          class="wails-no-drag flex items-center gap-2 rounded-md px-1 py-1 transition-colors duration-[120ms]"
        >
          <div
            id="sidebar-avatar"
            class="size-7 shrink-0 overflow-hidden rounded-full"
            style="background: linear-gradient(135deg, var(--lp-accent) 0%, #a855f7 100%)"
            aria-hidden="true"
          >
            <img id="sidebar-avatar-img" class="hidden size-full object-cover" src="" alt="" />
          </div>
          <div class="min-w-0 flex-1 leading-tight">
            <p class="text-lp-text truncate text-[11px] font-medium" id="sidebar-name">Personal</p>
            <p class="text-lp-muted truncate text-[10px]" id="sidebar-tier">Free Lifetime</p>
          </div>
          <!-- Shown when NOT logged in -->
          <button
            id="sidebar-login-btn"
            class="shrink-0 cursor-pointer rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 text-[10px] font-medium text-white/50 transition-[background-color,border-color,color] duration-150 hover:border-white/[0.14] hover:bg-white/[0.07] hover:text-white/75"
          >
            Sign in
          </button>
          <!-- Shown when logged in — chevron toggles dropdown -->
          <span
            id="user-chevron"
            class="hidden shrink-0 cursor-pointer text-white/30 transition-colors duration-[120ms] hover:text-white/60"
            aria-label="Account options"
          >
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </span>
        </div>
      </div>
    </aside>

    <!-- Main panel -->
    <section class="flex min-w-0 flex-1 flex-col overflow-hidden">
      <!-- ── Normal content ──────────────────────────────────── -->
      <div id="main-content" class="flex flex-1 flex-col overflow-hidden">
        <!-- Top bar -->
        <div
          class="border-lp-border wails-drag flex h-[52px] shrink-0 items-center justify-between border-b px-6"
        >
          <div class="wails-drag">
            <h1 class="text-sm leading-tight font-semibold tracking-[-0.01em]">
              Display Workspace
            </h1>
            <p class="text-lp-muted mt-px text-[11px]" id="monitor-subtitle">Loading displays…</p>
          </div>
        </div>

        <!-- Monitor canvas -->
        <div
          class="wails-drag relative min-h-[180px] flex-1 before:pointer-events-none before:absolute before:inset-0 before:bg-[radial-gradient(circle_at_50%_0%,rgba(47,138,239,0.05),transparent_65%)] before:content-['']"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-0 h-24 opacity-[0.08]"
            style="background-image:linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to top, black, transparent)"
          >
          </div>
          <div
            class="absolute inset-0 flex items-center justify-center overflow-hidden p-12"
            id="content"
          >
            <div class="loading">Loading monitors…</div>
          </div>
        </div>

        <!-- Wallpaper Gallery -->
        <div
          class="gallery-section wails-no-drag border-lp-border flex flex-col overflow-hidden border-t"
          id="gallery-section"
        >
          <!-- Gallery header -->
          <div class="flex shrink-0 items-center justify-between px-6 py-2.5">
            <div>
              <h2 class="text-[13px] font-semibold tracking-tight">Wallpaper Gallery</h2>
              <p class="text-lp-muted text-[11px]" id="gallery-count">Loading…</p>
            </div>
            <div class="flex items-center gap-1.5">
              <button class="gallery-nav-btn" id="gallery-prev" aria-label="Scroll left">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg
                >
              </button>
              <button class="gallery-nav-btn" id="gallery-next" aria-label="Scroll right">
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg
                >
              </button>
            </div>
          </div>
          <!-- Horizontal strip -->
          <div class="gallery-strip-wrap min-h-0 flex-1">
            <div class="gallery-strip-fade-l"></div>
            <div class="gallery-strip-fade-r"></div>
            <div class="gallery-strip wails-no-drag" id="gallery-strip"></div>
          </div>
          <!-- Dots — 1 per image -->
          <div class="flex shrink-0 items-center justify-center gap-1.5 py-2" id="gallery-dots">
          </div>
        </div>

        <Footer />
      </div><!-- /#main-content -->

      <!-- ── Alternate views (replace main content when open) ── -->
      <SettingsView />
      <DiscoverView />

      <!-- Library View -->
      <div id="library-panel" class="hidden flex-1 flex-col overflow-hidden">
        <div
          class="border-lp-border wails-drag flex h-[52px] shrink-0 items-center justify-between border-b px-6"
        >
          <div class="wails-drag">
            <h1 class="text-sm leading-tight font-semibold tracking-[-0.01em]">Library</h1>
            <p class="text-lp-muted mt-px text-[11px]" id="library-count">Your downloaded wallpapers</p>
          </div>
        </div>
        <div class="wails-no-drag lp-scroll flex-1 overflow-y-auto">
          <div class="p-3">
            <div id="library-grid">
              <div class="lib-empty">No wallpapers yet — download from Discover to add them here</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Monitor picker modal -->
  <div
    id="monitor-picker-modal"
    class="wails-no-drag fixed inset-0 z-[200] flex items-center justify-center bg-black/60"
    hidden
  >
    <div
      class="border-lp-border-strong w-[520px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
      role="dialog"
      aria-modal="true"
    >
      <div class="px-5 pt-5 pb-3">
        <p class="text-lp-text mb-1 text-[13px] font-semibold">Select Monitor</p>
        <p class="text-lp-muted text-[11px] leading-relaxed">
          Choose which monitor to apply this wallpaper to. Hover to preview.
        </p>
      </div>
      <div id="monitor-picker-grid" class="flex gap-3 px-5 pb-4">
        <!-- populated by JS -->
      </div>
      <div class="border-lp-border flex items-center justify-end gap-2 border-t px-5 py-3">
        <button
          id="monitor-picker-cancel"
          class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors duration-[120ms] hover:bg-white/[0.04]"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- Sign-out confirm modal -->
  <div
    id="signout-confirm-modal"
    class="wails-no-drag fixed inset-0 z-[200] flex items-center justify-center bg-black/60"
    hidden
  >
    <div
      class="border-lp-border-strong w-[300px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
      role="dialog"
      aria-modal="true"
    >
      <div class="px-5 pt-5 pb-5">
        <p class="text-lp-text mb-1 text-[13px] font-semibold">Sign out of Live Paper?</p>
        <p class="text-lp-muted mb-4 text-[11px] leading-relaxed">
          You'll need to sign in again to access your account.
        </p>
        <div class="flex items-center justify-end gap-2">
          <button
            id="signout-cancel-btn"
            class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors duration-[120ms] hover:bg-white/[0.04]"
          >
            Cancel
          </button>
          <button
            id="signout-confirm-btn"
            class="cursor-pointer rounded-md border border-red-500/30 bg-red-500/10 px-3 py-1.5 text-[12px] text-red-400 transition-colors duration-[120ms] hover:bg-red-500/20 hover:text-red-300"
          >
            Sign out
          </button>
        </div>
      </div>
    </div>
  </div>

  <LoginModal />

</Layout>

<script type="module" is:inline>
  import { Events, Call } from '/wails/runtime.js'

  // monitorIndex -> { filePath, cachedPath, isVideo, ready }
  const state = {}
  let monitors = []

  const contentEl = document.getElementById('content')
  const applyBtn = document.getElementById('apply-btn')
  const resetBtn = document.getElementById('reset-btn')
  const discardBtn = document.getElementById('discard-btn')
  const statusEl = document.getElementById('status')
  const dotEl = document.getElementById('ab-dot')

  let lastAppliedState = {}
  let pendingChanges = false

  function setFooterMode(mode) {
    const pendingActions = document.getElementById('footer-pending-actions')
    const pauseBtn = document.getElementById('pause-wallpaper-btn')
    if (mode === 'pending') {
      pendingActions?.classList.remove('hidden')
      pendingActions?.classList.add('flex')
      pauseBtn?.classList.add('hidden')
    } else {
      pendingActions?.classList.add('hidden')
      pendingActions?.classList.remove('flex')
      pauseBtn?.classList.remove('hidden')
    }
  }

  // ── View router (Displays / Discover / Billing / Settings) ───────
  let currentUser = null
  let appSettings = null
  let appVersion = ''
  let galleryCursor = -1
  const VIEW_PANELS = {
    displays: 'main-content',
    settings: 'settings-panel',
    discover: 'discover-panel',
    library: 'library-panel',
  }
  let currentView = 'displays'

  function showView(name) {
    if (!VIEW_PANELS[name]) return
    for (const [v, pid] of Object.entries(VIEW_PANELS)) {
      const el = document.getElementById(pid)
      if (!el) continue
      const on = v === name
      el.classList.toggle('hidden', !on)
      el.classList.toggle('flex', on)
      el.classList.toggle('lp-view', on)
    }
    document.querySelectorAll('.nav-item[data-view]').forEach((b) => {
      b.classList.toggle('active', b.dataset.view === name)
    })
    currentView = name
    if (name === 'discover') onShowDiscover()
    if (name === 'library') renderLibrary()
  }

  // ── Downloaded wallpapers tracking ───────────────────────────────
  const DOWNLOADED_KEY = 'livepaper_downloaded_v1'

  function getDownloadedMap() {
    try { return JSON.parse(localStorage.getItem(DOWNLOADED_KEY) || '{}') } catch { return {} }
  }

  function setDownloadedItem(id, info) {
    const m = getDownloadedMap()
    m[id] = info
    localStorage.setItem(DOWNLOADED_KEY, JSON.stringify(m))
  }

  function getDownloadedItem(id) {
    return getDownloadedMap()[id] || null
  }

  function isDownloaded(id) {
    return !!getDownloadedItem(id)
  }
  function openSettings() {
    showView('settings')
    prefetchConnections()
  }
  // Open Settings and activate a specific tab (e.g. "billing", "connections").
  function openSettingsTab(tabId) {
    showView('settings')
    prefetchConnections()
    const tab = document.querySelector(`.settings-tab[data-stab="${tabId}"]`)
    if (tab) tab.click()
  }

  document.getElementById('tb-settings').addEventListener('click', openSettings)
  document.getElementById('settings-back-btn').addEventListener('click', () => showView('displays'))
  document.querySelectorAll('.nav-item[data-view]').forEach((b) => {
    b.addEventListener('click', () => showView(b.dataset.view))
  })

  const STORAGE_KEY = 'livepaper_state_v1'

  // ── IndexedDB recent wallpapers ──────────────────────────────────
  const IDB_NAME = 'livepaper'
  const IDB_VERSION = 2
  const STORE_RECENT = 'recent'
  const RECENT_LIMIT = 50

  // ── Gallery state ────────────────────────────────────────────────
  let galleryItems = []

  function openDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(IDB_NAME, IDB_VERSION)
      req.onupgradeneeded = (e) => {
        const db = e.target.result
        if (db.objectStoreNames.contains(STORE_RECENT)) {
          db.deleteObjectStore(STORE_RECENT)
        }
        const store = db.createObjectStore(STORE_RECENT, { keyPath: 'id', autoIncrement: true })
        store.createIndex('fileKey', 'fileKey', { unique: true })
        store.createIndex('filePath', 'filePath', { unique: false })
      }
      req.onsuccess = (e) => resolve(e.target.result)
      req.onerror = (e) => reject(e.target.error)
    })
  }

  async function upsertRecent(entry) {
    const db = await openDB()
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_RECENT, 'readwrite')
      const store = tx.objectStore(STORE_RECENT)
      const getReq = store.index('fileKey').get(entry.fileKey)
      getReq.onsuccess = () => {
        const existing = getReq.result
        const record = { ...entry, appliedAt: Date.now() }
        if (existing) {
          record.id = existing.id
          store.put(record)
        } else store.add(record)
      }
      tx.oncomplete = () => resolve()
      tx.onerror = (e) => reject(e.target.error)
    })
  }

  async function pruneRecent() {
    const db = await openDB()
    return new Promise((resolve) => {
      const tx = db.transaction(STORE_RECENT, 'readwrite')
      const store = tx.objectStore(STORE_RECENT)
      store.count().onsuccess = (e) => {
        const total = e.target.result
        if (total <= RECENT_LIMIT) return
        const del = total - RECENT_LIMIT
        let deleted = 0
        store.openCursor().onsuccess = (ce) => {
          const cursor = ce.target.result
          if (!cursor || deleted >= del) return
          cursor.delete()
          deleted++
          cursor.continue()
        }
      }
      tx.oncomplete = () => resolve()
    })
  }

  // ── Gallery functions ─────────────────────────────────────────────
  async function loadGalleryItems() {
    const db = await openDB()
    return new Promise((resolve) => {
      const tx = db.transaction(STORE_RECENT, 'readonly')
      const store = tx.objectStore(STORE_RECENT)
      const items = []
      store.openCursor(null, 'prev').onsuccess = (e) => {
        const cursor = e.target.result
        if (cursor) {
          items.push(cursor.value)
          cursor.continue()
        } else resolve(items)
      }
      tx.onerror = () => resolve([])
    })
  }

  function buildGalleryCard(entry, index) {
    const card = document.createElement('div')
    card.className = 'gallery-strip-card wails-no-drag'
    card.draggable = true
    card.dataset.index = index

    let name, badgeClass, badgeText, payload, lockHtml
    if (entry.remote) {
      card.dataset.remote = '1'
      name = entry.title || 'Wallpaper'
      badgeClass = (entry.contentType || '').startsWith('video/') ? 'video' : 'image'
      badgeText = resolutionBadgeText(entry.width, entry.height) || 'HD'
      if (entry.width && entry.height) card.style.aspectRatio = `${entry.width} / ${entry.height}`
      payload = JSON.stringify({
        remote: true,
        id: entry.id,
        downloadUrl: entry.downloadUrl,
        tier: entry.tier,
        thumbnail: entry.thumbnail,
        title: entry.title,
      })
      lockHtml = `<span class="gc-lock${isPremium() ? ' hidden' : ''}" aria-hidden="true">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>`
    } else {
      const ext = extOf(entry.filePath)
      badgeClass = entry.isVideo && ext !== 'gif' ? 'video' : ext === 'gif' ? 'gif' : 'image'
      badgeText = entry.isVideo && ext !== 'gif' ? 'VIDEO' : ext === 'gif' ? 'GIF' : 'IMG'
      name = entry.filePath
        .replace(/\\/g, '/')
        .split('/')
        .pop()
        .replace(/\.[^.]+$/, '')
      if (entry.width && entry.height) card.style.aspectRatio = `${entry.width} / ${entry.height}`
      payload = JSON.stringify({
        filePath: entry.filePath,
        cachedPath: entry.cachedPath,
        isVideo: entry.isVideo,
        thumbnail: entry.thumbnail,
        width: entry.width || 0,
        height: entry.height || 0,
      })
      lockHtml = ''
    }

    card.innerHTML = `
      <img class="gc-img" src="${entry.thumbnail || ''}" alt="" draggable="false">
      <div class="gc-overlay"></div>
      <span class="gc-badge ${badgeClass}">${badgeText}</span>
      ${lockHtml || ''}
      <div class="gc-grip" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/>
          <circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/>
        </svg>
      </div>
      <div class="gc-info"><div class="gc-name"></div></div>
    `
    card.querySelector('.gc-name').textContent = name
    card.querySelector('.gc-img').alt = name

    card.addEventListener('dragstart', (e) => {
      e.dataTransfer.setData('application/livepaper', payload)
      e.dataTransfer.effectAllowed = 'copy'
      card.classList.add('dragging')
    })
    card.addEventListener('dragend', () => card.classList.remove('dragging'))

    // hover → activate matching dot
    card.addEventListener('mouseenter', () => setActiveDot(index))

    return card
  }

  function setActiveDot(index) {
    const dotsEl = document.getElementById('gallery-dots')
    if (!dotsEl) return
    dotsEl.querySelectorAll('.gallery-dot').forEach((d, i) => {
      d.classList.toggle('active', i === index)
    })
  }

  function renderGalleryStrip() {
    const strip = document.getElementById('gallery-strip')
    const countEl = document.getElementById('gallery-count')
    const dotsEl = document.getElementById('gallery-dots')
    const prevBtn = document.getElementById('gallery-prev')
    const nextBtn = document.getElementById('gallery-next')
    if (!strip) return

    strip.innerHTML = ''

    if (galleryItems.length === 0) {
      strip.innerHTML =
        '<div class="gallery-empty">No recent wallpapers yet — apply one to add it here</div>'
      if (countEl) countEl.textContent = 'No wallpapers yet'
      if (dotsEl) dotsEl.innerHTML = ''
      return
    }

    galleryItems.forEach((entry, i) => strip.appendChild(buildGalleryCard(entry, i)))

    const n = galleryItems.length
    if (countEl)
      countEl.textContent = `${n} wallpaper${n !== 1 ? 's' : ''} · Drag onto a monitor to assign`

    // build dots — 1 per image
    if (dotsEl) {
      dotsEl.innerHTML = ''
      galleryItems.forEach((_, i) => {
        const dot = document.createElement('button')
        dot.className = 'gallery-dot' + (i === 0 ? ' active' : '')
        dot.setAttribute('aria-label', `Wallpaper ${i + 1}`)
        dot.addEventListener('click', () => {
          const cards = strip.querySelectorAll('.gallery-strip-card')
          if (cards[i])
            cards[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' })
          setActiveDot(i)
        })
        dotsEl.appendChild(dot)
      })
    }

    // scroll buttons — move by ~260px per click
    if (prevBtn) {
      prevBtn.onclick = () => strip.scrollBy({ left: -260, behavior: 'smooth' })
    }
    if (nextBtn) {
      nextBtn.onclick = () => strip.scrollBy({ left: 260, behavior: 'smooth' })
    }
  }

  // Fetch the community catalog from the backend so the gallery always has
  // content to browse/drag, even before the user has applied anything locally.
  async function loadRemoteGalleryItems() {
    try {
      const res = await fetch(`${API_BASE}/api/wallpapers?limit=60`)
      const data = await res.json()
      return (data?.items || []).map((it) => ({
        remote: true,
        id: it.id,
        title: it.title,
        tier: it.tier || 'free',
        contentType: it.contentType || '',
        downloadUrl: it.downloadUrl,
        thumbnail: it.thumbnailUrl,
        width: it.width || 0,
        height: it.height || 0,
      }))
    } catch (_) {
      return []
    }
  }

  async function refreshGallery() {
    const [local, remote] = await Promise.all([loadGalleryItems(), loadRemoteGalleryItems()])
    // Local recents first (user's own history), then the community catalog.
    galleryItems = [...local, ...remote]
    renderGalleryStrip()
  }

  // Toggle the lock indicator on remote gallery cards based on subscription.
  function refreshGalleryLocks() {
    document.querySelectorAll('.gallery-strip-card[data-remote="1"] .gc-lock').forEach((el) => {
      el.classList.toggle('hidden', isPremium())
    })
  }

  async function clearRecentHistory() {
    const db = await openDB()
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_RECENT, 'readwrite')
      tx.objectStore(STORE_RECENT).clear()
      tx.oncomplete = () => resolve()
      tx.onerror = (e) => reject(e.target.error)
    })
  }

  function status(msg, type) {
    statusEl.textContent = msg || 'Running'
    statusEl.className = 'status' + (type ? ` ${type}` : '')
    if (dotEl) {
      if (type === 'error') dotEl.className = 'ab-dot error'
      else if (type === 'success' || !msg) dotEl.className = 'ab-dot'
      else dotEl.className = 'ab-dot busy'
    }
  }

  function refreshApply() {
    const anySelected = Object.values(state).some((s) => s.filePath)
    const anyProcessing = Object.values(state).some((s) => s.filePath && s.isVideo && !s.ready)
    applyBtn.disabled = !anySelected || anyProcessing
    resetBtn.disabled = !anySelected || anyProcessing
    setFooterMode(pendingChanges && anySelected && !anyProcessing ? 'pending' : 'applied')
  }

  function resetMonitor(idx) {
    delete state[idx]
    const block = document.getElementById(`mb-${idx}`)
    if (!block) return
    block.classList.remove('has-file', 'encoding')
    const bg = document.getElementById(`bg-${idx}`)
    if (bg) bg.src = ''
    const bd = document.getElementById(`bd-${idx}`)
    if (bd) {
      bd.style.display = 'none'
      bd.className = 'mon-badge'
    }
    const mp = document.getElementById(`mp-${idx}`)
    if (mp) mp.classList.remove('active')
  }

  function cancelEncode(idx) {
    const prev = lastAppliedState[idx]
    if (prev) {
      state[idx] = { ...prev }
      setEncoding(idx, false, 0)
      applyThumb(idx, prev.thumbnail, prev.filePath, prev.isVideo)
    } else {
      resetMonitor(idx)
    }
    const allIdxs = new Set([
      ...Object.keys(state).map(Number),
      ...Object.keys(lastAppliedState).map(Number),
    ])
    let dirty = false
    for (const i of allIdxs) {
      if ((state[i]?.filePath || '') !== (lastAppliedState[i]?.filePath || '')) {
        dirty = true
        break
      }
    }
    pendingChanges = dirty
    refreshApply()
  }

  async function call(method, ...args) {
    return await Call.ByName('main.AppService.' + method, ...args)
  }

  function extOf(p) {
    return p.replace(/\\/g, '/').split('/').pop().split('.').pop().toLowerCase()
  }

  function resolutionBadgeText(w, h) {
    if (!w || !h) return ''
    function gcd(a, b) { return b ? gcd(b, a % b) : a }
    const g = gcd(w, h)
    let ratio = `${w / g}:${h / g}`
    const r = w / h
    if (Math.abs(r - 16 / 9) < 0.05) ratio = '16:9'
    else if (Math.abs(r - 21 / 9) < 0.05) ratio = '21:9'
    else if (Math.abs(r - 4 / 3) < 0.05) ratio = '4:3'
    const res = w >= 7680 ? '8K' : w >= 3840 ? '4K' : w >= 2560 ? '2K' : `${w}p`
    return `${res} · ${ratio}`
  }

  function getMonitorViewport() {
    const cs = getComputedStyle(contentEl)
    return {
      width: Math.max(
        1,
        Math.floor(contentEl.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight))
      ),
      height: Math.max(
        1,
        Math.floor(
          contentEl.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom)
        )
      ),
      labelHeight: 28,
    }
  }

  // ── Virtual desktop builder ──────────────────────────────────────
  function buildStage(layout) {
    const stage = document.createElement('div')
    stage.className = 'vd-stage'
    stage.style.width = `${layout.stageWidth}px`
    stage.style.height = `${layout.stageHeight}px`

    // faint floor grid
    const grid = document.createElement('div')
    grid.className = 'vd-grid'
    stage.appendChild(grid)

    for (const m of layout.monitors) {
      const wrapper = document.createElement('div')
      wrapper.className = 'mon-wrapper'
      wrapper.style.cssText = `left:${m.previewX}px;top:${m.previewY}px;width:${m.previewWidth}px`

      const block = document.createElement('div')
      block.className = 'monitor-block' + (m.primary ? ' primary-mon' : '')
      block.id = `mb-${m.index}`
      block.style.height = `${m.previewHeight}px`

      block.innerHTML = `
        <div class="mon-inner">
          <img class="mon-bg" id="bg-${m.index}" src="" alt="">
          ${m.primary ? `<div class="mon-primary">Primary</div>` : ''}
          <span class="mon-badge" id="bd-${m.index}"></span>
          <div class="mon-info">
            <div class="mon-res">${m.width}×${m.height}</div>
          </div>
          <div class="mon-progress" id="mp-${m.index}">
            <div class="prog-ring-wrap">
              <svg class="prog-ring" viewBox="0 0 36 36" aria-hidden="true">
                <circle class="prog-ring-bg" cx="18" cy="18" r="15.9"/>
                <circle class="prog-ring-fill" id="pf-${m.index}" cx="18" cy="18" r="15.9"/>
              </svg>
              <span class="prog-pct" id="pl-${m.index}" aria-live="polite">0%</span>
              <div class="prog-cancel-btn" id="pc-${m.index}" role="button" aria-label="Cancel encoding" tabindex="0">
                <div class="prog-cancel-icon">
                  <span class="prog-cancel-label">Cancel</span>
                </div>
              </div>
            </div>
            <span class="prog-status-label">Encoding…</span>
          </div>
          <div class="mon-hover" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Choose File
          </div>
          <div class="mon-drop-overlay" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Drop to assign
          </div>
        </div>
      `

      block.addEventListener('click', () => {
        const s = state[m.index]
        if (s && s.isVideo && !s.ready) return
        browse(m.index, m.width, m.height)
      })

      const cancelBtn = block.querySelector(`#pc-${m.index}`)
      const doCancel = (e) => {
        e.stopPropagation()
        const s = state[m.index]
        if (s?.filePath) call('CancelEncoding', s.filePath)
      }
      cancelBtn?.addEventListener('click', doCancel)
      cancelBtn?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') doCancel(e)
      })

      // Gallery drag-and-drop onto monitor
      block.addEventListener('dragover', (e) => {
        if (!e.dataTransfer.types.includes('application/livepaper')) return
        const s = state[m.index]
        if (s?.isVideo && !s?.ready) return
        e.preventDefault()
        e.dataTransfer.dropEffect = 'copy'
        block.classList.add('drop-over')
      })
      block.addEventListener('dragleave', (e) => {
        if (!block.contains(e.relatedTarget)) block.classList.remove('drop-over')
      })
      block.addEventListener('drop', async (e) => {
        e.preventDefault()
        block.classList.remove('drop-over')
        const s = state[m.index]
        if (s?.isVideo && !s?.ready) return
        let entry
        try {
          entry = JSON.parse(e.dataTransfer.getData('application/livepaper'))
        } catch {
          return
        }

        // Community (remote) item: download first (subscription-gated), then stage.
        if (entry.remote) {
          await applyRemoteEntryToMonitor(entry, m)
          return
        }

        const isNonGifVideo = entry.isVideo && extOf(entry.filePath) !== 'gif'
        const resolutionMismatch =
          isNonGifVideo &&
          (!entry.width || !entry.height || entry.width !== m.width || entry.height !== m.height)

        if (resolutionMismatch) {
          state[m.index] = {
            filePath: entry.filePath,
            cachedPath: entry.filePath,
            isVideo: true,
            ready: false,
            thumbnail: entry.thumbnail,
          }
          applyThumb(m.index, entry.thumbnail, entry.filePath, true)
          pendingChanges = true
          refreshApply()
          setEncoding(m.index, true, 0)
          try {
            const cached = await call('PreprocessVideo', entry.filePath, m.width, m.height)
            state[m.index].cachedPath = cached
            state[m.index].ready = true
          } catch (_) {
            cancelEncode(m.index)
            status('Encoding cancelled.', '')
            return
          }
          setEncoding(m.index, false, 100)
          refreshApply()
          return
        }

        state[m.index] = {
          filePath: entry.filePath,
          cachedPath: entry.cachedPath || entry.filePath,
          isVideo: entry.isVideo,
          ready: true,
          thumbnail: entry.thumbnail,
        }
        applyThumb(m.index, entry.thumbnail, entry.filePath, entry.isVideo)
        pendingChanges = true
        refreshApply()
      })

      const label = document.createElement('p')
      label.className = 'mon-label'
      label.textContent = `Monitor ${m.index + 1}`

      wrapper.appendChild(block)
      wrapper.appendChild(label)
      stage.appendChild(wrapper)
    }
    return stage
  }

  function reapplyStageState() {
    for (const [idxStr, s] of Object.entries(state)) {
      if (!s.filePath) continue
      const idx = parseInt(idxStr)
      const block = document.getElementById(`mb-${idx}`)
      if (!block) continue
      block.classList.add('has-file')
      const bg = document.getElementById(`bg-${idx}`)
      if (bg) bg.src = s.thumbnail || ''
      const bd = document.getElementById(`bd-${idx}`)
      if (bd) {
        const e = extOf(s.filePath)
        bd.style.display = 'inline'
        if (s.isVideo && e !== 'gif') {
          bd.textContent = 'VIDEO'
          bd.className = 'mon-badge video'
        } else if (e === 'gif') {
          bd.textContent = 'GIF'
          bd.className = 'mon-badge gif'
        } else {
          bd.textContent = 'IMG'
          bd.className = 'mon-badge image'
        }
      }
      if (s.isVideo && !s.ready) setEncoding(idx, true, 0)
    }
  }

  async function renderMonitorLayout() {
    const viewport = getMonitorViewport()
    const layout = await call(
      'GetMonitorLayout',
      viewport.width,
      viewport.height,
      viewport.labelHeight
    )
    monitors = layout?.monitors || []
    contentEl.innerHTML = ''
    contentEl.appendChild(buildStage(layout))
    reapplyStageState()
  }

  // ── Card update helpers ──────────────────────────────────────────
  function applyThumb(idx, thumbnail, filePath, isVideo) {
    const block = document.getElementById(`mb-${idx}`)
    if (!block) return
    block.classList.add('has-file')

    const bg = document.getElementById(`bg-${idx}`)
    if (bg) bg.src = thumbnail || ''

    const e = extOf(filePath)
    const bd = document.getElementById(`bd-${idx}`)
    if (bd) {
      bd.style.display = 'inline'
      if (isVideo && e !== 'gif') {
        bd.textContent = 'VIDEO'
        bd.className = 'mon-badge video'
      } else if (e === 'gif') {
        bd.textContent = 'GIF'
        bd.className = 'mon-badge gif'
      } else {
        bd.textContent = 'IMG'
        bd.className = 'mon-badge image'
      }
    }
  }

  function setEncoding(idx, active, pct) {
    const block = document.getElementById(`mb-${idx}`)
    const mp = document.getElementById(`mp-${idx}`)
    const pf = document.getElementById(`pf-${idx}`)
    const pl = document.getElementById(`pl-${idx}`)
    if (!mp) return
    mp.classList.toggle('active', active)
    if (block) block.classList.toggle('encoding', active)
    if (pf) pf.style.strokeDashoffset = `${100 - pct}`
    if (pl) pl.textContent = `${pct}%`
  }

  // ── Browse / encode flow ─────────────────────────────────────────
  async function browse(idx, w, h) {
    status('Opening file picker…')
    let filePath
    try {
      filePath = await call('BrowseFile')
    } catch (e) {
      status(`Dialog error: ${e}`, 'error')
      return
    }
    status('')
    if (!filePath) return

    const isVideo = await call('IsVideoFile', filePath)
    const thumbnail = await call('GetThumbnail', filePath)

    state[idx] = { filePath, cachedPath: filePath, isVideo, ready: !isVideo, thumbnail }
    applyThumb(idx, thumbnail, filePath, isVideo)
    pendingChanges = true
    refreshApply()

    if (isVideo) {
      setEncoding(idx, true, 0)
      try {
        const cached = await call('PreprocessVideo', filePath, w, h)
        state[idx].cachedPath = cached
        state[idx].ready = true
      } catch (e) {
        cancelEncode(idx)
        status('Encoding cancelled.', '')
        return
      }
      setEncoding(idx, false, 100)
      refreshApply()
    }
  }

  // ── Progress events from Go ──────────────────────────────────────
  Events.On('video:progress', (evt) => {
    const d = evt?.data || {}
    for (const [idx, s] of Object.entries(state)) {
      if (s.filePath === d.file && !s.ready) {
        setEncoding(parseInt(idx), true, d.progress ?? 0)
      }
    }
  })

  // ── Apply ────────────────────────────────────────────────────────
  applyBtn.addEventListener('click', async () => {
    applyBtn.disabled = true
    status('Applying…')

    const list = Object.entries(state)
      .filter(([, s]) => s.filePath)
      .map(([idx, s]) => ({
        monitorIndex: parseInt(idx),
        filePath: s.cachedPath || s.filePath,
      }))

    try {
      await call('ApplyWallpapers', list)
      status('Applied!', 'success')
      lastAppliedState = {}
      for (const [idx, s] of Object.entries(state)) {
        if (s.filePath) lastAppliedState[parseInt(idx)] = { ...s }
      }
      pendingChanges = false
      saveState()
      // Persist each applied wallpaper to IndexedDB as recent
      await Promise.all(
        Object.entries(state)
          .filter(([, s]) => s.filePath)
          .map(([idx, s]) => {
            const monitor = monitors.find((mo) => mo.index === parseInt(idx))
            const w = monitor?.width || 0
            const h = monitor?.height || 0
            const isNonGifVideo = s.isVideo && extOf(s.filePath) !== 'gif'
            const fileKey = isNonGifVideo ? `${s.filePath}|${w}x${h}` : s.filePath
            return upsertRecent({
              fileKey,
              filePath: s.filePath,
              cachedPath: s.cachedPath,
              isVideo: s.isVideo,
              thumbnail: s.thumbnail,
              width: w,
              height: h,
            }).catch(() => {})
          })
      )
      pruneRecent().catch(() => {})
      refreshGallery().catch(() => {})
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Failed: ${e}`, 'error')
    }
    refreshApply()
  })

  // ── Discard staged changes ───────────────────────────────────────
  discardBtn?.addEventListener('click', () => {
    for (const idx of Object.keys(state).map(Number)) {
      if (!lastAppliedState[idx]) resetMonitor(idx)
    }
    for (const idx of Object.keys(state)) delete state[idx]
    for (const [idxStr, s] of Object.entries(lastAppliedState)) {
      const idx = parseInt(idxStr)
      state[idx] = { ...s }
      applyThumb(idx, s.thumbnail, s.filePath, s.isVideo)
    }
    pendingChanges = false
    refreshApply()
  })

  // ── Clean cache ──────────────────────────────────────────────────
  document.getElementById('clean-btn').addEventListener('click', async () => {
    const btn = document.getElementById('clean-btn')
    btn.disabled = true
    status('Cleaning cache…')
    try {
      await call('CleanTempFiles')
      await clearRecentHistory()
      await refreshGallery()
      status('Cache cleaned', 'success')
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Clean failed: ${e}`, 'error')
    }
    btn.disabled = false
  })

  // ── Reset ─────────────────────────────────────────────────────────
  resetBtn.addEventListener('click', async () => {
    resetBtn.disabled = true
    applyBtn.disabled = true
    status('Resetting…')
    try {
      await call('ResetWallpapers')
    } catch (_) {}
    for (const idx of Object.keys(state).map(Number)) resetMonitor(idx)
    lastAppliedState = {}
    pendingChanges = false
    localStorage.removeItem(STORAGE_KEY)
    await clearRecentHistory().catch(() => {})
    await refreshGallery().catch(() => {})
    status('Reset complete', 'success')
    setTimeout(() => status(''), 3000)
    refreshApply()
  })

  // ── State persistence ────────────────────────────────────────────
  function saveState() {
    const saved = {}
    for (const [idx, s] of Object.entries(state)) {
      if (s.filePath) {
        saved[idx] = { filePath: s.filePath, cachedPath: s.cachedPath, isVideo: s.isVideo }
      }
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(saved))
  }

  async function restoreState() {
    let saved
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null')
    } catch (_) {}
    if (!saved) return false

    for (const [idx, s] of Object.entries(saved)) {
      const i = parseInt(idx)
      if (!monitors.find((m) => m.index === i)) continue

      const exists = await call('FileExists', s.filePath)
      if (!exists) continue

      const cachedPath = s.cachedPath || s.filePath
      if (s.isVideo && !(await call('FileExists', cachedPath))) continue

      const thumbnail = await call('GetThumbnail', s.filePath)
      state[i] = { filePath: s.filePath, cachedPath, isVideo: s.isVideo, ready: true, thumbnail }
      applyThumb(i, thumbnail, s.filePath, s.isVideo)
    }
    refreshApply()
    return Object.keys(state).length > 0
  }

  async function autoApply() {
    const list = Object.entries(state)
      .filter(([, s]) => s.filePath && s.ready)
      .map(([idx, s]) => ({ monitorIndex: parseInt(idx), filePath: s.cachedPath || s.filePath }))
    if (list.length === 0) return

    status('Restoring…')
    try {
      await call('ApplyWallpapers', list)
      lastAppliedState = {}
      for (const [idx, s] of Object.entries(state)) {
        if (s.filePath) lastAppliedState[parseInt(idx)] = { ...s }
      }
      status('Restored', 'success')
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`failed: ${e}`, 'error')
    }
  }

