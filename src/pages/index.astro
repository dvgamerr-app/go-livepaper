  // ── Auth ─────────────────────────────────────────────────────────
  const API_BASE = 'https://sso.dvgamerr.app'
  const TOKEN_KEY = 'livepaper_auth_token'
  const USER_KEY = 'livepaper_auth_user'

  function getToken() {
    return localStorage.getItem(TOKEN_KEY)
  }
  function setToken(t) {
    localStorage.setItem(TOKEN_KEY, t)
  }
  function clearToken() {
