  const GH_REPO_DEFAULT = 'dvgamerr/go-livepaper'

  function debounce(fn, ms) {
    let t
    return (...a) => {
      clearTimeout(t)
      t = setTimeout(() => fn(...a), ms)
    }
  }
  function escapeHtml(s) {
    return String(s).replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    )
  }

