  // ── SSO — external browser + state polling ───────────────────────
  let pollTimer = null
  let pollTimeout = null
  let activeState = null
  let pollPauseUntil = 0

  function stopPoll() {
    if (pollTimer) {
      clearInterval(pollTimer)
      pollTimer = null
    }
    if (pollTimeout) {
      clearTimeout(pollTimeout)
      pollTimeout = null
    }
    activeState = null
  }

  async function startSSO(provider) {
    stopPoll()
    showSSOError('')

    activeState = crypto.randomUUID().replace(/-/g, '')
    const callbackURL = encodeURIComponent(`${API_BASE}/auth-callback?state=${activeState}`)
    const url = `${API_BASE}/api/auth/sign-in/social?provider=${provider}&callbackURL=${callbackURL}`

    // Open in system default browser via Go backend
    call('OpenExternal', url).catch(() => {})

    if (ssoWaitLabel)
      ssoWaitLabel.textContent = `Waiting for ${provider === 'github' ? 'GitHub' : 'Google'}…`
    setWaiting(true)

    const capturedState = activeState

    pollTimer = setInterval(async () => {
      if (Date.now() < pollPauseUntil) return
      try {
        const res = await fetch(`${API_BASE}/api/auth/exchange?state=${capturedState}`)
        if (res.ok) {
          const { token, user } = await res.json()
          stopPoll()
          setToken(token)
          await updateProfileUI(user)
          closeLoginModal()
        } else if (res.status === 429) {
          pollPauseUntil = Date.now() + 10_000
        } else if (res.status >= 400 && res.status < 500 && res.status !== 404) {
          stopPoll()
          setWaiting(false)
          showSSOError('Sign-in failed — please try again.')
        }
        // 404 = not yet exchanged, keep polling
        // 5xx = transient server error, keep polling
      } catch (_) {}
    }, 4000)

    pollTimeout = setTimeout(() => {
      if (activeState === capturedState) {
        stopPoll()
        setWaiting(false)
        showSSOError('Sign-in timed out — please try again.')
      }
    }, 180_000)
  }

  document.getElementById('sso-github')?.addEventListener('click', () => startSSO('github'))
  document.getElementById('sso-google')?.addEventListener('click', () => startSSO('google'))

  // ══ Settings · Discover · Billing ══════════════════════════════════
  const GH_REPO_DEFAULT = 'dvgamerr/go-livepaper'

  function debounce(fn, ms) {
    let t
    return (...a) => {
      clearTimeout(t)
      t = setTimeout(() => fn(...a), ms)
    }
  }
  function escapeHtml(s) {
    return String(s).replace(
      /[&<>"]/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
    )
  }

  // ── Toast / notifications ────────────────────────────────────────
  function lpToast(msg, type) {
    const wrap = document.getElementById('lp-toast')
    if (!wrap) return
    const el = document.createElement('div')
    el.className = 'lp-toast' + (type ? ` ${type}` : '')
    el.innerHTML = `<span class="dot"></span><span></span>`
    el.lastElementChild.textContent = msg
    wrap.appendChild(el)
    requestAnimationFrame(() => el.classList.add('show'))
    setTimeout(() => {
      el.classList.remove('show')
      setTimeout(() => el.remove(), 300)
    }, 2600)
  }
  function maybeToast(msg, type) {
    if (appSettings && appSettings.showNotifications) lpToast(msg, type)
  }

  // ── Telemetry ────────────────────────────────────────────────────
  async function track(name, props) {
    if (!appSettings || !appSettings.telemetry) return
    try {
      await fetch(`${API_BASE}/api/telemetry`, {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({
          appVersion,
          events: [{ name, props: props || {}, ts: Date.now() }],
        }),
      })
    } catch (_) {}
  }

