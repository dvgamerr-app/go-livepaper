        avatarImg.src = ''
        avatarImg.classList.add('hidden')
      }
    }
    refreshAuthDependentUI()
  }

  async function checkSession() {
    if (!getToken()) {
      clearCachedUser()
      return updateProfileUI(null)
    }
    // Restore cached user immediately so UI shows right away
    const cached = getCachedUser()
    if (cached) await updateProfileUI(cached)

    try {
      const res = await fetch(`${API_BASE}/api/auth/get-session`, { headers: authHeaders() })
      const data = await res.json()
      if (data?.user) {
        await updateProfileUI(data.user)
      } else {
        clearToken()
        await updateProfileUI(null)
      }
    } catch (_) {
      // Network error — keep cached user shown, don't clear
    }
  }

