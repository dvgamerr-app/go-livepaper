---
import Layout from '../layouts/Layout.astro';
import Titlebar from '../components/Titlebar.astro';
import DepWarn from '../components/DepWarn.astro';
import SettingsModal from '../components/SettingsModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Live Paper">
  <Titlebar />
  <DepWarn />

  <div class="flex-1 flex overflow-hidden wails-no-drag">
    <!-- Sidebar -->
    <aside class="w-56 shrink-0 border-r border-lp-border bg-[rgba(19,19,22,0.5)] backdrop-blur-[12px] flex flex-col wails-drag">
      <div class="p-2.5 pb-1.5 wails-no-drag">
        <input
          class="w-full h-[30px] px-2.5 bg-white/[0.04] border border-lp-border rounded-md text-lp-text text-[11px] outline-none transition-[border-color,background-color] duration-150 placeholder:text-lp-muted focus:border-[rgba(47,138,239,0.5)] focus:bg-white/[0.06]"
          placeholder="Search library…" tabindex="-1" readonly />
      </div>

      <nav class="px-2 flex flex-col gap-0.5 wails-no-drag">
        <!-- Displays — active/functional -->
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-lp-accent-soft text-lp-text text-[12px] font-medium cursor-pointer transition-colors duration-[120ms] text-left whitespace-nowrap overflow-hidden" aria-current="page">
          <span class="shrink-0 text-lp-accent flex items-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>
            </svg>
          </span>
          Displays
          <span class="ml-auto w-1.5 h-1.5 rounded-full bg-lp-accent shrink-0"></span>
        </button>

        <!-- Placeholder nav items -->
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1">
          <span class="shrink-0 text-lp-muted flex items-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            </svg>
          </span>
          Playlists
          <span class="ml-auto text-[10px] px-1.5 py-px rounded bg-white/[0.06] text-lp-muted shrink-0">—</span>
        </button>

        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1">
          <span class="shrink-0 text-lp-muted flex items-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
            </svg>
          </span>
          Live Wallpapers
        </button>

        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1">
          <span class="shrink-0 text-lp-muted flex items-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </span>
          Static
        </button>

        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1">
          <span class="shrink-0 text-lp-muted flex items-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          Local Folders
        </button>
      </nav>

      <div class="px-[18px] pt-4 pb-1 text-[10px] font-semibold text-lp-muted uppercase tracking-[0.12em] wails-drag">Collections</div>
      <div class="px-2 flex flex-col gap-0.5 wails-no-drag">
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1"><span class="w-2 h-2 rounded-full shrink-0" style="background:#34d399"></span>Atmospheric</button>
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1"><span class="w-2 h-2 rounded-full shrink-0" style="background:#a78bfa"></span>Cyberpunk</button>
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1"><span class="w-2 h-2 rounded-full shrink-0" style="background:#f472b6"></span>Anime</button>
        <button class="w-full h-8 flex items-center gap-2 px-2.5 border-0 rounded-md bg-transparent text-lp-muted text-[12px] font-medium cursor-default opacity-[0.38] text-left whitespace-nowrap overflow-hidden" tabindex="-1"><span class="w-2 h-2 rounded-full shrink-0" style="background:#fbbf24"></span>Nature</button>
      </div>

      <div class="mt-auto border-t border-lp-border flex items-center gap-2 px-2.5 min-w-0 h-9 wails-no-drag">
        <span class="w-[7px] h-[7px] rounded-full bg-lp-success shrink-0 transition-colors duration-300" id="ab-dot"></span>
        <span class="status text-[11px] min-w-0" id="status" role="status" aria-live="polite"></span>
      </div>
    </aside>

    <!-- Main panel -->
    <section class="flex-1 flex flex-col overflow-hidden min-w-0">

      <!-- Top bar -->
      <div class="h-[52px] shrink-0 flex items-center justify-between px-6 border-b border-lp-border wails-drag">
        <div class="wails-drag">
          <h1 class="text-sm font-semibold tracking-[-0.01em] leading-tight">Display Workspace</h1>
          <p class="text-[11px] text-lp-muted mt-px" id="monitor-subtitle">Loading displays…</p>
        </div>
      </div>

      <!-- Monitor canvas -->
      <div class="flex-1 min-h-[100px] relative wails-drag before:content-[''] before:absolute before:inset-0 before:pointer-events-none before:bg-[radial-gradient(circle_at_50%_0%,rgba(47,138,239,0.05),transparent_65%)]">
        <div class="absolute inset-0 flex items-center justify-center p-12 overflow-hidden" id="content">
          <div class="loading">Loading monitors…</div>
        </div>
      </div>

      <Footer />
    </section>
  </div>

  <SettingsModal />
</Layout>

<script type="module" is:inline>
  import { Events, Call } from '/wails/runtime.js'

  // monitorIndex -> { filePath, cachedPath, isVideo, ready }
  const state = {}
  let monitors = []

  const contentEl     = document.getElementById('content')
  const applyBtn      = document.getElementById('apply-btn')
  const resetBtn      = document.getElementById('reset-btn')
  const statusEl      = document.getElementById('status')
  const dotEl         = document.getElementById('ab-dot')
  const settingsModal = document.getElementById('settings-modal')
document.getElementById('tb-settings').addEventListener('click', () => { settingsModal.hidden = false })
  document.getElementById('modal-close').addEventListener('click',  () => { settingsModal.hidden = true  })
  settingsModal.addEventListener('click', (e) => { if (e.target === settingsModal) settingsModal.hidden = true })

  const STORAGE_KEY = 'livepaper_state_v1'

  function status(msg, type) {
    statusEl.textContent = msg
    statusEl.className = 'status' + (type ? ` ${type}` : '')
    if (dotEl) {
      dotEl.className = 'ab-dot' + (type === 'error' ? ' busy' : '')
    }
  }

  function refreshApply() {
    const anySelected   = Object.values(state).some(s => s.filePath)
    const anyProcessing = Object.values(state).some(s => s.filePath && s.isVideo && !s.ready)
    applyBtn.disabled = !anySelected || anyProcessing
    resetBtn.disabled = !anySelected || anyProcessing
  }

  function resetMonitor(idx) {
    delete state[idx]
    const block = document.getElementById(`mb-${idx}`)
    if (!block) return
    block.classList.remove('has-file', 'encoding')
    const bg = document.getElementById(`bg-${idx}`)
    if (bg) bg.src = ''
    const bd = document.getElementById(`bd-${idx}`)
    if (bd) { bd.style.display = 'none'; bd.className = 'mon-badge' }
    const mp = document.getElementById(`mp-${idx}`)
    if (mp) mp.classList.remove('active')
  }

  async function call(method, ...args) {
    return await Call.ByName('main.AppService.' + method, ...args)
  }

  function extOf(p) {
    return p.replace(/\\/g, '/').split('/').pop().split('.').pop().toLowerCase()
  }

  // ── Virtual desktop builder ──────────────────────────────────────
  function buildStage(mons) {
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity
    for (const m of mons) {
      minX = Math.min(minX, m.x);        minY = Math.min(minY, m.y)
      maxX = Math.max(maxX, m.x + m.width); maxY = Math.max(maxY, m.y + m.height)
    }
    const totalW = maxX - minX
    const totalH = maxY - minY

    const cs     = getComputedStyle(contentEl)
    const availW = contentEl.clientWidth  - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight)
    const availH = contentEl.clientHeight - parseFloat(cs.paddingTop)  - parseFloat(cs.paddingBottom)
    const scale  = Math.min(availW / totalW, availH / totalH, 1)

    const stageW = Math.round(totalW * scale)
    const stageH = Math.round(totalH * scale)

    const stage = document.createElement('div')
    stage.className = 'vd-stage'
    stage.style.width  = `${stageW}px`
    stage.style.height = `${stageH}px`

    for (const m of mons) {
      const bx = Math.round((m.x - minX) * scale)
      const by = Math.round((m.y - minY) * scale)
      const bw = Math.round(m.width  * scale)
      const bh = Math.round(m.height * scale)

      const block = document.createElement('div')
      block.className = 'monitor-block'
      block.id = `mb-${m.index}`
      block.style.cssText = `left:${bx}px;top:${by}px;width:${bw}px;height:${bh}px`

      block.innerHTML = `
        <div class="mon-inner">
          <img class="mon-bg" id="bg-${m.index}" src="" alt="">
          ${m.primary ? `<div class="mon-primary">Primary</div>` : ''}
          <div class="mon-info">
            <div class="mon-name">Monitor ${m.index + 1}</div>
            <div class="mon-res">${m.width}×${m.height}</div>
          </div>
          <span class="mon-badge" id="bd-${m.index}"></span>
          <div class="mon-progress" id="mp-${m.index}">
            <div class="prog-label" id="pl-${m.index}">Encoding…</div>
            <div class="prog-track"><div class="prog-fill" id="pf-${m.index}" style="width:0%"></div></div>
          </div>
          <div class="mon-hover" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Choose File
          </div>
        </div>
      `

      block.addEventListener('click', () => {
        const s = state[m.index]
        if (s && s.isVideo && !s.ready) return
        browse(m.index, m.width, m.height)
      })

      stage.appendChild(block)
    }
    return stage
  }

  // ── Card update helpers ──────────────────────────────────────────
  function applyThumb(idx, thumbnail, filePath, isVideo) {
    const block = document.getElementById(`mb-${idx}`)
    if (!block) return
    block.classList.add('has-file')

    const bg = document.getElementById(`bg-${idx}`)
    if (bg) bg.src = thumbnail || ''

    const e  = extOf(filePath)
    const bd = document.getElementById(`bd-${idx}`)
    if (bd) {
      bd.style.display = 'inline'
      if (isVideo && e !== 'gif') { bd.textContent = 'VIDEO'; bd.className = 'mon-badge video' }
      else if (e === 'gif')       { bd.textContent = 'GIF';   bd.className = 'mon-badge gif'   }
      else                        { bd.textContent = 'IMG';   bd.className = 'mon-badge image' }
    }
  }

  function setEncoding(idx, active, pct) {
    const block = document.getElementById(`mb-${idx}`)
    const mp    = document.getElementById(`mp-${idx}`)
    const pf    = document.getElementById(`pf-${idx}`)
    const pl    = document.getElementById(`pl-${idx}`)
    if (!mp) return
    mp.classList.toggle('active', active)
    if (block) block.classList.toggle('encoding', active)
    if (pf) pf.style.width = `${pct}%`
    if (pl) pl.textContent = active ? `Encoding ${pct}%` : 'Done'
  }

  // ── Browse / encode flow ─────────────────────────────────────────
  async function browse(idx, w, h) {
    status('Opening file picker…')
    let filePath
    try {
      filePath = await call('BrowseFile')
    } catch (e) {
      status(`Dialog error: ${e}`, 'error')
      return
    }
    status('')
    if (!filePath) return

    const isVideo   = await call('IsVideoFile', filePath)
    const thumbnail = await call('GetThumbnail', filePath)

    state[idx] = { filePath, cachedPath: filePath, isVideo, ready: !isVideo, thumbnail }
    applyThumb(idx, thumbnail, filePath, isVideo)
    refreshApply()

    if (isVideo) {
      setEncoding(idx, true, 0)
      try {
        const cached = await call('PreprocessVideo', filePath, w, h)
        state[idx].cachedPath = cached
        state[idx].ready = true
      } catch (e) {
        status(`Encode error: ${e}`, 'error')
        state[idx].ready = false
      }
      setEncoding(idx, false, 100)
      refreshApply()
    }
  }

  // ── Progress events from Go ──────────────────────────────────────
  Events.On('video:progress', (evt) => {
    const d = evt?.data || {}
    for (const [idx, s] of Object.entries(state)) {
      if (s.filePath === d.file) {
        setEncoding(parseInt(idx), true, d.progress ?? 0)
      }
    }
  })

  // ── Apply ────────────────────────────────────────────────────────
  applyBtn.addEventListener('click', async () => {
    applyBtn.disabled = true
    status('Applying…')

    const list = Object.entries(state)
      .filter(([, s]) => s.filePath)
      .map(([idx, s]) => ({
        monitorIndex: parseInt(idx),
        filePath: s.cachedPath || s.filePath,
      }))

    try {
      await call('ApplyWallpapers', list)
      status('Applied!', 'success')
      saveState()
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Failed: ${e}`, 'error')
    }
    refreshApply()
  })

  // ── Clean cache ──────────────────────────────────────────────────
  document.getElementById('clean-btn').addEventListener('click', async () => {
    const btn = document.getElementById('clean-btn')
    btn.disabled = true
    status('Cleaning cache…')
    try {
      await call('CleanTempFiles')
      status('Cache cleaned', 'success')
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Clean failed: ${e}`, 'error')
    }
    btn.disabled = false
  })

  // ── Reset ─────────────────────────────────────────────────────────
  resetBtn.addEventListener('click', async () => {
    resetBtn.disabled = true
    applyBtn.disabled = true
    status('Resetting…')
    try { await call('ResetWallpapers') } catch (_) {}
    for (const idx of Object.keys(state).map(Number)) resetMonitor(idx)
    localStorage.removeItem(STORAGE_KEY)
    status('Reset complete', 'success')
    setTimeout(() => status(''), 3000)
    refreshApply()
  })

  // ── State persistence ────────────────────────────────────────────
  function saveState() {
    const saved = {}
    for (const [idx, s] of Object.entries(state)) {
      if (s.filePath) {
        saved[idx] = { filePath: s.filePath, cachedPath: s.cachedPath, isVideo: s.isVideo }
      }
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(saved))
  }

  async function restoreState() {
    let saved
    try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null') } catch (_) {}
    if (!saved) return false

    for (const [idx, s] of Object.entries(saved)) {
      const i = parseInt(idx)
      if (!monitors.find(m => m.index === i)) continue

      const exists = await call('FileExists', s.filePath)
      if (!exists) continue

      const cachedPath = s.cachedPath || s.filePath
      if (s.isVideo && !await call('FileExists', cachedPath)) continue

      const thumbnail = await call('GetThumbnail', s.filePath)
      state[i] = { filePath: s.filePath, cachedPath, isVideo: s.isVideo, ready: true, thumbnail }
      applyThumb(i, thumbnail, s.filePath, s.isVideo)
    }
    refreshApply()
    return Object.keys(state).length > 0
  }

  async function autoApply() {
    const list = Object.entries(state)
      .filter(([, s]) => s.filePath && s.ready)
      .map(([idx, s]) => ({ monitorIndex: parseInt(idx), filePath: s.cachedPath || s.filePath }))
    if (list.length === 0) return

    status('Restoring wallpaper…')
    try {
      await call('ApplyWallpapers', list)
      status('Wallpaper restored', 'success')
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Restore failed: ${e}`, 'error')
    }
  }

  // ── Resize: rebuild stage when canvas size changes ───────────────
  let resizeTimer
  const ro = new ResizeObserver(() => {
    clearTimeout(resizeTimer)
    resizeTimer = setTimeout(() => {
      if (monitors.length === 0) return
      contentEl.innerHTML = ''
      contentEl.appendChild(buildStage(monitors))
      // Re-apply wallpaper state to the newly created monitor blocks
      for (const [idxStr, s] of Object.entries(state)) {
        if (!s.filePath) continue
        const idx = parseInt(idxStr)
        const block = document.getElementById(`mb-${idx}`)
        if (!block) continue
        block.classList.add('has-file')
        const bg = document.getElementById(`bg-${idx}`)
        if (bg) bg.src = s.thumbnail || ''
        const bd = document.getElementById(`bd-${idx}`)
        if (bd) {
          const e = extOf(s.filePath)
          bd.style.display = 'inline'
          if (s.isVideo && e !== 'gif') { bd.textContent = 'VIDEO'; bd.className = 'mon-badge video' }
          else if (e === 'gif')         { bd.textContent = 'GIF';   bd.className = 'mon-badge gif'   }
          else                          { bd.textContent = 'IMG';   bd.className = 'mon-badge image' }
        }
        if (s.isVideo && !s.ready) setEncoding(idx, true, 0)
      }
    }, 80)
  })

  // ── Init ──────────────────────────────────────────────────────────
  async function init() {
    try {
      monitors = await call('GetMonitors')
      const ver = await call('GetVersion')
      const verText = ver ? `v${ver}` : ''
      document.getElementById('tb-version').textContent = verText
      const modalVer = document.getElementById('modal-version')
      if (modalVer) modalVer.textContent = verText || '—'

      const n = monitors.length
      document.getElementById('monitor-subtitle').textContent =
        `${n} display${n !== 1 ? 's' : ''} connected · Click a monitor to assign a wallpaper`
    } catch (e) {
      contentEl.innerHTML = `<div class="loading" style="color:var(--lp-danger)">Failed to load monitors: ${e}</div>`
      return
    }

    try {
      const deps = await call('CheckDependencies')
      const missing = Object.entries(deps).filter(([, ok]) => !ok).map(([k]) => k)
      if (missing.length > 0) {
        const warnEl = document.getElementById('dep-warn')
        const msgEl  = document.getElementById('dep-warn-msg')
        msgEl.innerHTML = `Missing: <strong>${missing.join(', ')}</strong> — video wallpapers won't work. Run <code style="background:rgba(255,255,255,0.08);padding:1px 5px;border-radius:3px">scripts\\install-deps.ps1</code> to install.`
        warnEl.style.display = 'flex'
      }
    } catch (_) {}

    contentEl.innerHTML = ''
    contentEl.appendChild(buildStage(monitors))
    ro.observe(contentEl)

    const hasRestored = await restoreState()
    if (hasRestored) autoApply()
  }

  document.getElementById('tb-min').addEventListener('click',   () => call('WindowMinimise').catch(() => {}))
  document.getElementById('tb-close').addEventListener('click', () => call('WindowHide').catch(() => {}))

  // ── GPU stats polling ─────────────────────────────────────────────
  const gpuEl = document.getElementById('gpu-stats')
  async function updateGPUStats() {
    if (!gpuEl) return
    try {
      const s = await call('GetGPUStats')
      if (!s) return
      const pct  = Math.round(s.usagePct)
      const vram = s.usedMB >= 1024
        ? `${(s.usedMB / 1024).toFixed(1)} GB`
        : `${s.usedMB} MB`
      gpuEl.textContent = `GPU · ${pct}% · ${vram} VRAM`
      gpuEl.classList.remove('hidden')
    } catch (_) {
      gpuEl.classList.add('hidden')
    }
  }
  setTimeout(() => {
    updateGPUStats()
    setInterval(updateGPUStats, 2000)
  }, 1500)

  init()
</script>
