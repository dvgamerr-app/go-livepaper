  // ── Settings binding ─────────────────────────────────────────────
  function setToggle(el, on) {
    el.classList.toggle('on', !!on)
    el.setAttribute('aria-checked', on ? 'true' : 'false')
  }
  const saveSettingsDebounced = debounce(() => {
    if (appSettings) call('SaveSettings', appSettings).catch(() => {})
  }, 250)

  function renderSettings() {
    if (!appSettings) return
    document
      .querySelectorAll('.lp-toggle[data-setting]')
      .forEach((b) => setToggle(b, appSettings[b.dataset.setting]))
    document.querySelectorAll('select[data-setting]').forEach((sel) => {
      if (appSettings[sel.dataset.setting] != null) sel.value = appSettings[sel.dataset.setting]
    })
    const vram = document.querySelector('input[type=range][data-setting="vramCapMB"]')
    if (vram) {
      vram.value = appSettings.vramCapMB
      const lbl = document.getElementById('vram-cap-label')
      if (lbl) lbl.textContent = `${appSettings.vramCapMB} MB`
    }
    document
      .querySelectorAll('.theme-seg[data-setting="windowTheme"]')
      .forEach((s) => s.classList.toggle('active', s.dataset.value === appSettings.windowTheme))
    document.querySelectorAll('.lp-kbd[data-hotkey]').forEach((b) => {
      b.textContent = (appSettings.hotkeys && appSettings.hotkeys[b.dataset.hotkey]) || '—'
    })
  }

  function bindSettingsControls() {
    document.querySelectorAll('.lp-toggle[data-setting]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.setting
        appSettings[key] = !appSettings[key]
        setToggle(btn, appSettings[key])
        if (key === 'telemetry' && appSettings.telemetry) track('telemetry_enabled')
        saveSettingsDebounced()
        // GPU acceleration changes mpv's decoder — re-apply running video
        // wallpapers so the new CPU/GPU path takes effect immediately.
        if (key === 'gpuAcceleration') reapplyVideoWallpapers()
      })
    })
    document.querySelectorAll('select[data-setting]').forEach((sel) => {
      sel.addEventListener('change', () => {
        appSettings[sel.dataset.setting] = sel.value
        saveSettingsDebounced()
      })
    })
    const vram = document.querySelector('input[type=range][data-setting="vramCapMB"]')
    if (vram) {
      vram.addEventListener('input', () => {
        appSettings.vramCapMB = parseInt(vram.value, 10)
        const lbl = document.getElementById('vram-cap-label')
        if (lbl) lbl.textContent = `${appSettings.vramCapMB} MB`
        saveSettingsDebounced()
      })
    }
    document.querySelectorAll('.theme-seg[data-setting="windowTheme"]').forEach((seg) => {
      seg.addEventListener('click', () => {
        appSettings.windowTheme = seg.dataset.value
        document
          .querySelectorAll('.theme-seg[data-setting="windowTheme"]')
          .forEach((s) => s.classList.toggle('active', s.dataset.value === appSettings.windowTheme))
        applyWindowThemeCss(appSettings.windowTheme)
        saveSettingsDebounced()
      })
    })
    document.querySelectorAll('.lp-kbd[data-hotkey]').forEach((btn) => {
      btn.addEventListener('click', () => startHotkeyCapture(btn))
    })
  }

  // settings tab switching
  document.querySelectorAll('.settings-tab[data-stab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.stab
      document.querySelectorAll('.settings-tab[data-stab]').forEach((t) => {
        const on = t === tab
        t.classList.toggle('bg-lp-accent-soft', on)
        t.classList.toggle('bg-transparent', !on)
        t.classList.toggle('text-lp-text', on)
        t.classList.toggle('text-lp-muted', !on)
        t.setAttribute('aria-selected', on ? 'true' : 'false')
        const dot = t.querySelector('.dot')
        if (dot) dot.style.display = on ? '' : 'none'
