  async function onShowDiscover() {
    refreshDiscoverLock()
    if (!discoverLoaded) await loadDiscover()
  }
  async function loadDiscover() {
    const grid = document.getElementById('discover-grid')
    if (!grid) return
    grid.innerHTML = '<div class="discover-empty">Loading community wallpapers…</div>'
    try {
      const res = await fetch(`${API_BASE}/api/wallpapers?limit=60`)
      const data = await res.json()
      discoverItems = (data && data.items) || []
    } catch (_) {
      discoverItems = []
    }
    discoverLoaded = true
    renderDiscover(document.getElementById('discover-search')?.value || '')
  }
  function renderDiscover(filter) {
    const grid = document.getElementById('discover-grid')
    if (!grid) return
    const q = (filter || '').trim().toLowerCase()
    const items = q
      ? discoverItems.filter((i) => (i.title || '').toLowerCase().includes(q))
      : discoverItems
    if (!items.length) {
      grid.innerHTML = `<div class="discover-empty">${discoverItems.length ? 'No matches for your search.' : 'No community wallpapers yet — check back soon.'}</div>`
      return
    }
    grid.innerHTML = ''
    for (const it of items) {
      const tier = it.tier || 'free'
      const badgeClass = tier === 'top' ? 'top' : tier === 'premium' ? 'video' : 'image'
      const card = document.createElement('div')
      card.className = 'discover-card'
      card.innerHTML = `
        <img alt="" loading="lazy" draggable="false">
        <div class="dc-grad"></div>
        <span class="dc-badge ${badgeClass}">${tier.toUpperCase()}</span>
        <button class="dc-apply" type="button">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Apply
        </button>
        <div class="dc-info"><div class="dc-title"></div></div>`
      card.querySelector('img').src = it.thumbnailUrl || ''
      card.querySelector('.dc-title').textContent = it.title || 'Untitled'
      const ab = card.querySelector('.dc-apply')
      ab.setAttribute('aria-label', `Apply ${it.title || 'wallpaper'}`)
      ab.addEventListener('click', (e) => {
        e.stopPropagation()
        onDiscoverApply(it)
      })
      grid.appendChild(card)
    }
    refreshDiscoverLock()
  }

  async function onDiscoverApply(it) {
    if (!getToken()) {
      lpToast('Sign in to apply community wallpapers', 'error')
      openSettingsTab('billing')
      return
    }
    if (!isPremium()) {
      openSettingsTab('billing')
      return
    }
    const target = monitors.find((m) => m.primary) || monitors[0]
    if (!target) {
      lpToast('No display detected', 'error')
      return
    }
    status('Downloading…')
    let path
    try {
      path = await call('DownloadToTemp', it.downloadUrl, getToken(), it.id)
    } catch (e) {
      if (String(e).includes('premium_required')) {
        openSettingsTab('billing')
        status('')
      } else status('Download failed', 'error')
      return
    }
    const isVideo = await call('IsVideoFile', path)
    const thumbnail = await call('GetThumbnail', path)
    let cached = path
    if (isVideo && extOf(path) !== 'gif') {
      status('Encoding…')
      try {
        cached = await call('PreprocessVideo', path, target.width, target.height)
      } catch (_) {
        status('Encoding cancelled.')
        return
      }
    }
    status('Applying…')
    try {
      await call('ApplyWallpapers', [{ monitorIndex: target.index, filePath: cached }])
      state[target.index] = { filePath: path, cachedPath: cached, isVideo, ready: true, thumbnail }
      showView('displays')
      applyThumb(target.index, thumbnail, path, isVideo)
      refreshApply()
      saveState()
      await upsertRecent({
        fileKey: path,
        filePath: path,
        cachedPath: cached,
        isVideo,
        thumbnail,
        width: target.width,
        height: target.height,
      }).catch(() => {})
      pruneRecent().catch(() => {})
      await refreshGallery().catch(() => {})
      status('Applied!', 'success')
      track('discover_apply', { id: it.id })
      setTimeout(() => status(''), 3000)
    } catch (e) {
      status(`Failed: ${e}`, 'error')
    }
  }

  // Drop of a community (remote) gallery card onto a monitor: gate, download,
  // encode if needed, then stage it (user clicks Apply to commit — same as local).
  async function applyRemoteEntryToMonitor(entry, m) {
    if (!getToken()) {
      lpToast('Sign in to apply community wallpapers', 'error')
      openSettingsTab('billing')
      return
    }
    if (!isPremium()) {
      openSettingsTab('billing')
      return
    }
    status('Downloading…')
    let path
    try {
      path = await call('DownloadToTemp', entry.downloadUrl, getToken(), entry.id)
    } catch (e) {
      if (String(e).includes('premium_required')) {
        openSettingsTab('billing')
        status('')
      } else status('Download failed', 'error')
      return
    }
    const isVideo = await call('IsVideoFile', path)
    const thumbnail = await call('GetThumbnail', path)
    let cached = path
    if (isVideo && extOf(path) !== 'gif') {
      state[m.index] = { filePath: path, cachedPath: path, isVideo: true, ready: false, thumbnail }
      applyThumb(m.index, thumbnail, path, true)
      refreshApply()
      setEncoding(m.index, true, 0)
      try {
        cached = await call('PreprocessVideo', path, m.width, m.height)
      } catch (_) {
        resetMonitor(m.index)
        status('Encoding cancelled.', '')
        return
      }
      setEncoding(m.index, false, 100)
    }
    state[m.index] = { filePath: path, cachedPath: cached, isVideo, ready: true, thumbnail }
    applyThumb(m.index, thumbnail, path, isVideo)
    refreshApply()
    status('Ready — click Apply Wallpapers', '')
  }

  document
    .getElementById('discover-search')
    ?.addEventListener('input', (e) => renderDiscover(e.target.value))
  document.getElementById('discover-refresh')?.addEventListener('click', () => {
    discoverLoaded = false
    loadDiscover()
  })
  document
    .getElementById('discover-unlock-btn')
    ?.addEventListener('click', () => openSettingsTab('billing'))

  // ── Billing ──────────────────────────────────────────────────────
  let billingPricing = null

  async function onShowBilling() {
    const signin = document.getElementById('billing-signin')
    const free = document.getElementById('billing-free')
    const active = document.getElementById('billing-active')
    if (!signin || !free || !active) return
    if (!getToken()) {
      signin.classList.remove('hidden')
      signin.classList.add('flex')
      free.classList.add('hidden')
      active.classList.add('hidden')
      return
    }
    signin.classList.add('hidden')
    signin.classList.remove('flex')
    let st = null
    try {
      st = await (await fetch(`${API_BASE}/api/billing/status`, { headers: authHeaders() })).json()
    } catch (_) {}
    if (st && st.tier === 'premium' && st.subscription && st.subscription.status === 'active') {
      renderBillingActive(st.subscription)
    } else {
      await renderBillingFree()
    }
  }
  function renderBillingActive(sub) {
    document.getElementById('billing-active').classList.remove('hidden')
    document.getElementById('billing-free').classList.add('hidden')
    document.getElementById('billing-active-plan').textContent =
      sub.plan === 'monthly' ? 'Monthly' : sub.plan || 'Monthly'
    document.getElementById('billing-active-price').textContent = `$${sub.priceUsd}`
    document.getElementById('billing-active-renew').textContent = sub.currentPeriodEnd
      ? new Date(sub.currentPeriodEnd).toLocaleDateString()
      : '—'
    document.getElementById('billing-active-starred').classList.toggle('hidden', !sub.starred)
  }
  async function renderBillingFree() {
    document.getElementById('billing-free').classList.remove('hidden')
    document.getElementById('billing-active').classList.add('hidden')
    let pr = null
    try {
      pr = await (await fetch(`${API_BASE}/api/billing/pricing`, { headers: authHeaders() })).json()
    } catch (_) {}
    billingPricing = pr
    applyPricingUI(pr)
  }
  function applyPricingUI(pr) {
    const repo = (pr && pr.repo) || GH_REPO_DEFAULT
    const repoEl = document.getElementById('billing-repo')
    if (repoEl) repoEl.textContent = repo
    const price = pr ? pr.priceUsd : 9
    const base = pr ? pr.baseUsd : 9
    const starred = pr ? pr.starred : false
    document.getElementById('billing-price').textContent = `$${price}`
    document.getElementById('billing-subscribe-price').textContent = `$${price}`
    const strike = document.getElementById('billing-price-strike')
    strike.classList.toggle('hidden', !starred)
    strike.textContent = `$${base}`
    const note = document.getElementById('billing-price-note')
    const statusEl2 = document.getElementById('billing-star-status')
    if (starred) {
      note.textContent = 'GitHub-star discount applied 🎉'
      statusEl2.innerHTML = `You starred <span class="font-mono">${escapeHtml(repo)}</span> — enjoy $${price}/mo.`
    } else {
      note.textContent = 'Apply any community wallpaper.'
      statusEl2.innerHTML = `Star <span class="font-mono">${escapeHtml(repo)}</span> on GitHub to drop the price from $${base} to $4.`
    }
  }

  document.getElementById('billing-signin-btn')?.addEventListener('click', () => openLoginModal())
  document.getElementById('billing-star-btn')?.addEventListener('click', () => {
    const repo = (billingPricing && billingPricing.repo) || GH_REPO_DEFAULT
    call('OpenExternal', `https://github.com/${repo}`).catch(() => {})
  })
  document.getElementById('billing-recheck-btn')?.addEventListener('click', async () => {
    try {
      const r = await (
        await fetch(`${API_BASE}/api/billing/star-check`, {
          method: 'POST',
          headers: authHeaders(),
        })
      ).json()
      if (billingPricing) {
        billingPricing.starred = r.starred
        billingPricing.priceUsd = r.priceUsd
      }
      applyPricingUI(billingPricing || { priceUsd: r.priceUsd, baseUsd: 9, starred: r.starred })
      lpToast(
        r.starred ? 'Star confirmed — $4/mo unlocked' : 'No star found yet — star the repo first',
        r.starred ? 'success' : 'error'
      )
    } catch (_) {
      lpToast('Could not verify star', 'error')
    }
  })
  document.getElementById('billing-subscribe-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('billing-subscribe-btn')
    btn.disabled = true
    try {
      const r = await (
        await fetch(`${API_BASE}/api/billing/subscribe`, { method: 'POST', headers: authHeaders() })
      ).json()
      if (r && r.ok) {
        lpToast('Community access active 🎉', 'success')
        track('subscribe', { priceUsd: r.subscription && r.subscription.priceUsd })
        await checkSession()
        onShowBilling()
      } else {
        lpToast('Subscription failed', 'error')
      }
    } catch (_) {
      lpToast('Subscription failed', 'error')
    }
    btn.disabled = false
  })
  document.getElementById('billing-cancel-btn')?.addEventListener('click', async () => {
    try {
      await fetch(`${API_BASE}/api/billing/cancel`, { method: 'POST', headers: authHeaders() })
      lpToast('Subscription canceled', '')
      await checkSession()
      onShowBilling()
    } catch (_) {
      lpToast('Cancel failed', 'error')
    }
  })

  // ── Auth-dependent UI (license, gating, billing refresh) ─────────
  function refreshAuthDependentUI() {
    const lic = document.getElementById('about-license')
    const licDesc = document.getElementById('about-license-desc')
    if (lic) {
      const prem = isPremium()
      lic.textContent = prem ? 'Community' : 'Free Lifetime'
      if (licDesc)
        licDesc.textContent = prem
          ? 'Community access — apply community wallpapers.'
          : 'Free — all local features, unlimited.'
    }
    refreshDiscoverLock()
    refreshGalleryLocks()
    const billingPanel = document.querySelector('[data-spanel="billing"]')
    if (currentView === 'settings' && billingPanel && !billingPanel.hidden) onShowBilling()
    const connPanel = document.querySelector('[data-spanel="connections"]')
    if (currentView === 'settings' && connPanel && !connPanel.hidden) onShowConnections()
  }

  // ── Connections (Settings → Connections) ─────────────────────────
  async function onShowConnections() {
    const signin = document.getElementById('connections-signin')
    const content = document.getElementById('connections-content')
    if (!signin || !content) return
    if (!getToken()) {
      signin.classList.remove('hidden')
      signin.classList.add('flex')
      content.classList.add('hidden')
      return
    }
    signin.classList.add('hidden')
    signin.classList.remove('flex')
    content.classList.remove('hidden')
    let c = null
    try {
      c = await (await fetch(`${API_BASE}/api/connections`, { headers: authHeaders() })).json()
    } catch (_) {}
    renderConnections(c)
  }
  function renderConnections(c) {
    const gh = c && c.github
    const ghStatus = document.getElementById('gh-status')
    const ghBtn = document.getElementById('gh-connect-btn')
    const starStatus = document.getElementById('conn-star-status')
    const repoEl = document.getElementById('conn-repo')
    if (repoEl && c && c.repo) repoEl.textContent = c.repo
    if (ghStatus && ghBtn) {
      if (gh && gh.connected) {
        ghStatus.textContent = gh.login ? `Connected as @${gh.login}` : 'Connected'
        ghStatus.className = 'setting-desc text-lp-success'
        ghBtn.textContent = 'Reconnect'
      } else {
        ghStatus.textContent = 'Not connected — link GitHub to unlock the star discount.'
        ghStatus.className = 'setting-desc'
        ghBtn.textContent = 'Connect GitHub'
      }
    }
    if (starStatus) {
      const starred = c && c.starred
      starStatus.textContent = starred
        ? 'You starred the repo — $4/mo unlocked.'
        : 'Not starred yet — star the repo to save $5/mo.'
      starStatus.className = 'setting-desc' + (starred ? ' text-lp-success' : '')
    }
  }
  document
    .getElementById('connections-signin-btn')
    ?.addEventListener('click', () => openLoginModal())
  document.getElementById('gh-connect-btn')?.addEventListener('click', () => {
    if (typeof startSSO === 'function') startSSO('github')
  })
  document.getElementById('conn-star-btn')?.addEventListener('click', () => {
    const repo = (billingPricing && billingPricing.repo) || GH_REPO_DEFAULT
    call('OpenExternal', `https://github.com/${repo}`).catch(() => {})
  })
  document.getElementById('conn-recheck-btn')?.addEventListener('click', async () => {
    try {
      await fetch(`${API_BASE}/api/billing/star-check`, { method: 'POST', headers: authHeaders() })
    } catch (_) {}
    onShowConnections()
  })

  // ── Hotkeys (events emitted from Go) ─────────────────────────────
  async function cycleGallery(dir) {
    // Hotkeys cycle only local wallpapers (remote items require a gated download).
    const localItems = galleryItems.filter((it) => !it.remote)
    if (!localItems.length) {
      lpToast('No local wallpapers to cycle', 'error')
      return
    }
    galleryCursor = (galleryCursor + dir + localItems.length) % localItems.length
    const entry = localItems[galleryCursor]
    const target = monitors.find((m) => m.primary) || monitors[0]
    if (!target || !entry) return
    status('Applying…')
    try {
      let cached = entry.cachedPath || entry.filePath
      const isNonGifVideo = entry.isVideo && extOf(entry.filePath) !== 'gif'
      if (isNonGifVideo && (entry.width !== target.width || entry.height !== target.height)) {
        cached = await call('PreprocessVideo', entry.filePath, target.width, target.height)
      }
      await call('ApplyWallpapers', [{ monitorIndex: target.index, filePath: cached }])
      state[target.index] = {
        filePath: entry.filePath,
        cachedPath: cached,
        isVideo: entry.isVideo,
        ready: true,
        thumbnail: entry.thumbnail,
      }
      applyThumb(target.index, entry.thumbnail, entry.filePath, entry.isVideo)
      refreshApply()
      saveState()
      status('Applied!', 'success')
      setTimeout(() => status(''), 2000)
    } catch (e) {
      status(`Failed: ${e}`, 'error')
    }
  }

  Events.On('hotkey:next', () => cycleGallery(1))
  Events.On('hotkey:prev', () => cycleGallery(-1))
  Events.On('hotkey:open', () => showView('displays'))
  Events.On('video:paused', (evt) => {
    const p = evt && evt.data && evt.data.paused
    status(p ? 'Paused' : 'Resumed', '')
    setTimeout(() => status(''), 1500)
  })

  // telemetry on apply (attempt)
  applyBtn.addEventListener('click', () => track('wallpaper_applied'))

  initSettings()

  checkSession()
</script>
