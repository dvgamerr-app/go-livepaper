---
import { Settings, Minus, Square, X } from '@lucide/astro'
---

<header
  class="border-lp-border wails-drag flex h-10 shrink-0 items-center justify-between border-b bg-[rgba(19,19,22,0.85)] pr-1 pl-4 backdrop-blur-[20px]"
>
  <div class="wails-drag flex items-center gap-2.5">
    <img src="/icon.svg" width="16" height="16" alt="" aria-hidden="true" />
    <span class="text-lp-text text-xs font-semibold tracking-[0.03em]">Live Paper</span>
    <span class="text-lp-muted ml-0.5 text-[10px] font-medium" id="tb-version"></span>
  </div>
  <div class="wails-no-drag flex items-center gap-0.5">
    <button
      class="titlebar-control"
      id="tb-settings"
      type="button"
      title="Settings"
      aria-label="Settings"
    >
      <Settings size={14} stroke-width={2} aria-hidden="true" />
    </button>
    <button
      class="titlebar-control"
      id="tb-min"
      type="button"
      title="Minimise"
      aria-label="Minimise"
    >
      <Minus size={14} stroke-width={2} aria-hidden="true" />
    </button>
    <button
      class="titlebar-control"
      id="tb-max"
      type="button"
      title="Maximise"
      aria-label="Maximise"
    >
      <Square size={11} stroke-width={2} aria-hidden="true" />
    </button>
    <button
      class="titlebar-control titlebar-control-close"
      id="tb-close"
      type="button"
      title="Close"
      aria-label="Close"
    >
      <X size={14} stroke-width={2} aria-hidden="true" />
    </button>
  </div>
</header>
