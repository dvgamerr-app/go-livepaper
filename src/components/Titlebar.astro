---
---
<header class="titlebar">
  <div class="tb-left">
    <img src="/icon.svg" width="16" height="16" alt="" aria-hidden="true" />
    <span class="tb-title">LivePaper</span>
    <span class="tb-version" id="tb-version"></span>
  </div>
  <div class="tb-controls">
    <button class="tb-btn" id="tb-min" title="Minimise" aria-label="Minimise">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/>
      </svg>
    </button>
    <button class="tb-btn close" id="tb-close" title="Close" aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>
  </div>
</header>
