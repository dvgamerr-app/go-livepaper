---
import { Settings, Minus, Square, X } from '@lucide/astro'
---

<header
  class="border-lp-border wails-drag flex h-10 shrink-0 items-center justify-between border-b bg-[rgba(19,19,22,0.85)] pr-1 pl-4 backdrop-blur-[20px]"
>
  <div class="wails-drag flex items-center gap-2.5">
    <img src="/icon.svg" width="16" height="16" alt="" aria-hidden="true" />
    <span class="text-lp-text text-xs font-semibold tracking-[0.03em]">Live Paper</span>
    <span class="text-lp-muted ml-0.5 text-[10px] font-medium" id="tb-version"></span>
  </div>
  <div class="wails-no-drag flex items-center gap-0.5">
    <button
      class="text-lp-muted hover:text-lp-text grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-white/[0.06]"
      id="tb-settings"
      title="Settings"
      aria-label="Settings"
    >
      <Settings size={14} strokeWidth={2} aria-hidden="true" />
    </button>
    <button
      class="text-lp-muted hover:text-lp-text grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-white/[0.06]"
      id="tb-min"
      title="Minimise"
      aria-label="Minimise"
    >
      <Minus size={14} strokeWidth={2} aria-hidden="true" />
    </button>
    <button
      class="text-lp-muted hover:text-lp-text grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-white/[0.06]"
      id="tb-max"
      title="Maximise"
      aria-label="Maximise"
    >
      <Square size={11} strokeWidth={2} aria-hidden="true" />
    </button>
    <button
      class="text-lp-muted grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-red-500/75 hover:text-white"
      id="tb-close"
      title="Close"
      aria-label="Close"
    >
      <X size={14} strokeWidth={2} aria-hidden="true" />
    </button>
  </div>
</header>
