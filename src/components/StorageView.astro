---
import { Upload } from '@lucide/astro'
import ViewHeader from './ViewHeader.astro'
---

<div id="storage-panel" class="hidden flex-1 flex-col overflow-hidden">
  <ViewHeader title="Storage" subtitle="Loading wallpapers…" subtitleId="storage-count">
    <button
      slot="actions"
      id="storage-upload-btn"
      class="wails-no-drag bg-lp-accent inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.12] px-3 text-[12px] font-semibold text-white transition-colors hover:bg-[#4a9fff]"
    >
      <Upload size={13} stroke-width={2.5} aria-hidden="true" />
      Upload
    </button>
  </ViewHeader>
  <div class="wails-no-drag lp-scroll flex-1 overflow-y-auto">
    <div class="px-6 py-4">
      <table class="storage-table w-full" id="storage-table">
        <thead>
          <tr>
            <th class="w-24">Thumb</th>
            <th>Title</th>
            <th class="w-10">Status</th>
            <th class="w-28 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="storage-tbody">
          <tr><td colspan="4" class="storage-empty">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
