---

---

<footer
  class="border-lp-border wails-no-drag flex h-14 shrink-0 items-center justify-between border-t bg-[rgba(19,19,22,0.8)] px-5 backdrop-blur-[16px]"
>
  <div class="text-lp-muted flex min-w-0 flex-1 items-center gap-2 text-[11px]">
    <div class="flex w-18 shrink-0 items-center gap-2">
      <span class="ab-dot" id="ab-dot"></span>
      <span class="status truncate font-medium" id="status" role="status" aria-live="polite"
        >Running</span
      >
    </div>
    <span class="bg-lp-border mx-1.5 hidden h-3 w-px shrink-0" id="gpu-sep"></span>
    <span id="gpu-stats" class="hidden font-mono tabular-nums"></span>
  </div>

  <div class="flex items-center gap-1.5">
    <button
      class="bg-lp-accent inline-flex h-10 cursor-pointer items-center gap-1.5 rounded-md border-0 px-[18px] text-xs font-semibold whitespace-nowrap text-white shadow-[0_8px_24px_-8px_rgba(47,138,239,0.55)] transition-[opacity,background-color] duration-150 enabled:hover:bg-[#4a9fff] disabled:cursor-not-allowed disabled:opacity-30 disabled:shadow-none"
      id="apply-btn"
      disabled
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      Apply Wallpapers
    </button>
  </div>
</footer>
