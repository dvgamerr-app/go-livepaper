---
// Community wallpaper browser. Grid is populated by the inline script in
// index.astro from the backend (`/api/wallpapers`). Everyone can browse; Apply
// is gated behind a community subscription.
---

<div id="discover-panel" class="hidden flex-1 flex-col overflow-hidden">
  <!-- Header -->
  <div
    class="border-lp-border wails-drag flex h-[52px] shrink-0 items-center justify-between border-b px-6"
  >
    <div class="wails-drag">
      <h1 class="text-sm leading-tight font-semibold tracking-[-0.01em]">Discover</h1>
      <p class="text-lp-muted mt-px text-[11px]">Community live wallpapers from the Workshop</p>
    </div>
    <button
      id="discover-refresh"
      class="wails-no-drag text-lp-muted hover:text-lp-text grid h-9 w-9 cursor-pointer place-items-center rounded-md border border-white/[0.08] bg-transparent transition-colors hover:bg-white/[0.05]"
      aria-label="Refresh"
      title="Refresh"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"
        ></path>
      </svg>
    </button>
  </div>

  <div class="wails-no-drag lp-scroll flex-1 overflow-y-auto">
    <!-- Search + filters -->
    <div
      class="border-lp-border bg-lp-bg/80 sticky top-0 z-10 border-b px-6 pt-4 pb-3 backdrop-blur-xl"
    >
      <div class="relative max-w-md">
        <svg
          class="text-lp-muted absolute top-1/2 left-3 -translate-y-1/2"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
        >
        <input
          id="discover-search"
          type="search"
          placeholder="Search wallpapers, creators, tags…"
          class="border-lp-border text-lp-text placeholder:text-lp-muted focus:border-lp-accent/60 h-9 w-full rounded-md border bg-white/[0.04] pr-3 pl-9 text-[12px] outline-none"
        />
      </div>
    </div>

    <!-- Subscription lock notice (free users) -->
    <div
      id="discover-lock"
      class="mx-6 mt-5 hidden items-center gap-3 rounded-xl border border-[rgba(245,158,11,0.28)] bg-[rgba(245,158,11,0.08)] p-4"
    >
      <span
        class="text-lp-warn grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-[rgba(245,158,11,0.16)]"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
            d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
        >
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-lp-text text-[12.5px] font-semibold">
          Browsing is free — applying needs a subscription
        </p>
        <p class="text-lp-muted text-[11px] leading-snug">
          Unlock one-click apply for every community wallpaper from <strong>$4/mo</strong>.
        </p>
      </div>
      <button
        id="discover-unlock-btn"
        class="bg-lp-accent inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-md px-4 text-[12px] font-semibold text-white transition-colors hover:bg-[#4a9fff]"
      >
        Unlock
      </button>
    </div>

    <!-- Grid -->
    <div class="px-6 py-5">
      <div id="discover-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div class="discover-loading text-lp-muted col-span-full py-12 text-center text-[12px]">
          Loading community wallpapers…
        </div>
      </div>
    </div>
  </div>
</div>
