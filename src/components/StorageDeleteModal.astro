---

---

<div
  id="storage-delete-modal"
  class="wails-no-drag fixed inset-0 z-[210] flex items-center justify-center bg-black/65"
  hidden
>
  <div
    class="border-lp-border-strong w-[320px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
    role="dialog"
    aria-modal="true"
  >
    <div class="px-5 pt-5 pb-4">
      <p class="text-lp-text mb-1 text-[13px] font-semibold">Delete wallpaper?</p>
      <p class="text-lp-muted text-[11px] leading-relaxed">
        This will permanently remove the wallpaper and its files from storage. This cannot be
        undone.
      </p>
      <p class="text-lp-warn mt-2 text-[11px] font-medium" id="storage-delete-name"></p>
    </div>
    <div class="border-lp-border flex items-center justify-end gap-2 border-t px-5 py-3">
      <button
        id="storage-delete-cancel"
        class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors hover:bg-white/[0.04]"
        >Cancel</button
      >
      <button
        id="storage-delete-confirm"
        class="cursor-pointer rounded-md border border-red-500/30 bg-red-500/10 px-3 py-1.5 text-[12px] text-red-400 transition-colors hover:bg-red-500/20 hover:text-red-300"
        >Delete permanently</button
      >
    </div>
  </div>
</div>
