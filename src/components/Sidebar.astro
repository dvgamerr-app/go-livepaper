---

---

<aside
  class="border-lp-border wails-drag flex w-56 shrink-0 flex-col border-r bg-[rgba(19,19,22,0.5)] backdrop-blur-[12px]"
>
  <div class="wails-no-drag p-2.5 pb-1.5">
    <input
      class="border-lp-border text-lp-text placeholder:text-lp-muted h-[30px] w-full rounded-md border bg-white/[0.04] px-2.5 text-[11px] transition-[border-color,background-color] duration-150 outline-none focus:border-[rgba(47,138,239,0.5)] focus:bg-white/[0.06]"
      placeholder="Search library…"
      tabindex="-1"
      readonly
    />
  </div>

  <nav class="wails-no-drag flex flex-col gap-0.5 px-2">
    <button
      class="nav-item active flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
      data-view="displays"
    >
      <span class="nav-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path>
        </svg>
      </span>
      Displays
      <span class="nav-dot"></span>
    </button>

    <button
      class="nav-item flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
      data-view="discover"
    >
      <span class="nav-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </span>
      Discover
      <span class="nav-dot"></span>
    </button>

    <button
      class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
      tabindex="-1"
      title="Coming soon"
      aria-disabled="true"
    >
      <span class="text-lp-muted flex shrink-0 items-center">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
        </svg>
      </span>
      Playlists
      <span class="text-lp-muted ml-auto shrink-0 rounded bg-white/[0.06] px-1.5 py-px text-[10px]">—</span>
    </button>

    <button
      class="nav-item flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
      data-view="library"
    >
      <span class="nav-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      </span>
      Library
      <span class="nav-dot"></span>
    </button>

    <button
      class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]"
      tabindex="-1"
      title="Coming soon"
      aria-disabled="true"
    >
      <span class="text-lp-muted flex shrink-0 items-center">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
        </svg>
      </span>
      Local Folders
    </button>
  </nav>

  <!-- Admin section — shown only when user has admin role -->
  <div
    id="admin-sidebar-section"
    class="text-lp-muted wails-drag px-[18px] pt-4 pb-1 text-[10px] font-semibold tracking-[0.12em] uppercase hidden"
  >
    Admin
  </div>
  <div id="admin-nav-items" class="wails-no-drag hidden flex-col gap-0.5 px-2">
    <button
      class="nav-item flex h-8 w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap transition-colors duration-[120ms]"
      data-view="storage"
    >
      <span class="nav-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
      </span>
      Storage
      <span class="nav-dot"></span>
    </button>
  </div>

  <div class="text-lp-muted wails-drag px-[18px] pt-4 pb-1 text-[10px] font-semibold tracking-[0.12em] uppercase">
    Collections
  </div>
  <div class="wails-no-drag flex flex-col gap-0.5 px-2">
    <button class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]" tabindex="-1" title="Coming soon" aria-disabled="true">
      <span class="swatch-atmospheric h-2 w-2 shrink-0 rounded-full"></span>Atmospheric
    </button>
    <button class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]" tabindex="-1" title="Coming soon" aria-disabled="true">
      <span class="swatch-cyberpunk h-2 w-2 shrink-0 rounded-full"></span>Cyberpunk
    </button>
    <button class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]" tabindex="-1" title="Coming soon" aria-disabled="true">
      <span class="swatch-anime h-2 w-2 shrink-0 rounded-full"></span>Anime
    </button>
    <button class="text-lp-muted flex h-8 w-full cursor-default items-center gap-2 overflow-hidden rounded-md border-0 bg-transparent px-2.5 text-left text-[12px] font-medium whitespace-nowrap opacity-[0.38]" tabindex="-1" title="Coming soon" aria-disabled="true">
      <span class="swatch-nature h-2 w-2 shrink-0 rounded-full"></span>Nature
    </button>
  </div>

  <!-- User profile -->
  <div class="border-lp-border relative mt-auto border-t p-2.5" id="user-profile-section">
    <!-- Dropdown — opens upward, visible only when logged in -->
    <div
      id="user-dropdown"
      class="absolute right-2.5 bottom-[calc(100%+2px)] left-2.5 overflow-hidden rounded-lg border border-white/[0.08] bg-[#1c1c1f] shadow-[0_-8px_32px_rgba(0,0,0,0.6)]"
      hidden
    >
      <button
        id="dd-settings"
        class="flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-3 py-2.5 text-left text-[12px] text-white/70 transition-colors duration-[120ms] hover:bg-white/[0.06] hover:text-white/90"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        Settings
      </button>
      <div class="mx-3 h-px bg-white/[0.06]"></div>
      <button
        id="dd-signout"
        class="flex w-full cursor-pointer items-center gap-2.5 border-0 bg-transparent px-3 py-2.5 text-left text-[12px] text-white/70 transition-colors duration-[120ms] hover:bg-red-500/[0.08] hover:text-red-400"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Sign out
      </button>
    </div>

    <div
      id="user-profile-row"
      class="wails-no-drag flex items-center gap-2 rounded-md px-1 py-1 transition-colors duration-[120ms]"
    >
      <div
        id="sidebar-avatar"
        class="size-7 shrink-0 overflow-hidden rounded-full"
        style="background: linear-gradient(135deg, var(--lp-accent) 0%, #a855f7 100%)"
        aria-hidden="true"
      >
        <img id="sidebar-avatar-img" class="hidden size-full object-cover" src="" alt="" />
      </div>
      <div class="min-w-0 flex-1 leading-tight">
        <p class="text-lp-text truncate text-[11px] font-medium" id="sidebar-name">Personal</p>
        <p class="text-lp-muted truncate text-[10px]" id="sidebar-tier">Free Lifetime</p>
      </div>
      <button
        id="sidebar-login-btn"
        class="shrink-0 cursor-pointer rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 text-[10px] font-medium text-white/50 transition-[background-color,border-color,color] duration-150 hover:border-white/[0.14] hover:bg-white/[0.07] hover:text-white/75"
      >
        Sign in
      </button>
      <span
        id="user-chevron"
        class="hidden shrink-0 cursor-pointer text-white/30 transition-colors duration-[120ms] hover:text-white/60"
        aria-label="Account options"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </span>
    </div>
  </div>
</aside>
