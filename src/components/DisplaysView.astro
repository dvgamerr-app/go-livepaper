---
import Footer from './Footer.astro'
import ViewHeader from './ViewHeader.astro'
import { ChevronLeft, ChevronRight } from '@lucide/astro'
---

<div id="main-content" class="flex flex-1 flex-col overflow-hidden">
  <ViewHeader
    title="Display Workspace"
    subtitle="Loading displays…"
    subtitleId="monitor-subtitle"
  />

  <!-- Monitor canvas -->
  <div class="monitor-workspace wails-drag relative min-h-[180px] flex-1">
    <div
      class="absolute inset-0 flex items-center justify-center overflow-hidden p-12"
      id="content"
    >
      <div class="loading">Loading monitors…</div>
    </div>
  </div>

  <!-- Recent Wallpaper gallery -->
  <div
    class="gallery-section wails-no-drag border-lp-border flex flex-col overflow-hidden border-t"
    id="gallery-section"
  >
    <div class="flex shrink-0 items-center justify-between px-6 py-2.5">
      <div>
        <h2 class="text-[13px] font-semibold tracking-tight">Recent Wallpaper</h2>
        <p class="text-lp-muted text-[11px]" id="gallery-count">Loading…</p>
      </div>
      <div class="flex items-center gap-1.5">
        <button class="gallery-nav-btn" id="gallery-prev" aria-label="Scroll left">
          <ChevronLeft size={13} stroke-width={2.5} aria-hidden="true" />
        </button>
        <button class="gallery-nav-btn" id="gallery-next" aria-label="Scroll right">
          <ChevronRight size={13} stroke-width={2.5} aria-hidden="true" />
        </button>
      </div>
    </div>
    <div class="gallery-strip-wrap min-h-0 flex-1">
      <div class="gallery-strip wails-no-drag" id="gallery-strip"></div>
    </div>
    <div class="flex shrink-0 items-center justify-center gap-1.5 py-2" id="gallery-dots"></div>
  </div>

  <Footer />
</div>
