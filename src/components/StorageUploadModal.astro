---
import { Plus } from '@lucide/astro'
---

<div id="storage-upload-modal" class="wails-no-drag fixed inset-0 z-[210] flex items-center justify-center bg-black/65" hidden>
  <div
    class="border-lp-border-strong flex w-[520px] max-h-[78vh] flex-col overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="upload-modal-title"
  >
    <!-- Header -->
    <div class="shrink-0 px-5 pt-5 pb-3">
      <p class="text-lp-text mb-0.5 text-[13px] font-semibold" id="upload-modal-title">Upload Wallpapers</p>
      <p class="text-lp-muted text-[11px]">
        Select one or more images or videos.
        All items are set to <span class="text-lp-warn font-semibold">Premium</span> tier.
      </p>
    </div>

    <!-- Drop zone -->
    <div class="shrink-0 px-5 pb-3">
      <button
        id="upload-file-zone"
        type="button"
        class="border-lp-border flex w-full cursor-pointer flex-col items-center justify-center gap-1.5 rounded-lg border-2 border-dashed bg-white/[0.02] py-4 transition-colors hover:border-lp-accent hover:bg-lp-accent-soft"
      >
        <Plus size={18} stroke-width={1.5} class="text-lp-muted" aria-hidden="true" />
        <span class="text-lp-muted text-[11px]">Click to add files</span>
      </button>
    </div>

    <!-- File list (shown once files are added) -->
    <div id="upload-file-list" class="upload-file-list lp-scroll hidden flex-1 overflow-y-auto px-5 pb-3"></div>

    <!-- Overall progress (shown during upload) -->
    <div id="upload-progress-wrap" class="hidden shrink-0 px-5 pb-3">
      <div class="border-lp-border overflow-hidden rounded-full border bg-white/[0.04]" style="height:5px">
        <div id="upload-progress-bar" class="h-full rounded-full bg-lp-accent transition-[width]" style="width:0%"></div>
      </div>
      <p class="text-lp-muted mt-1.5 text-[10px]" id="upload-progress-label">Preparing…</p>
    </div>

    <!-- Footer actions -->
    <div class="border-lp-border flex shrink-0 items-center justify-end gap-2 border-t px-5 py-3">
      <button
        id="upload-cancel-btn"
        class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors hover:bg-white/[0.04]"
      >Cancel</button>
      <button
        id="upload-submit-btn"
        class="cursor-pointer rounded-md bg-lp-accent px-4 py-1.5 text-[12px] font-semibold text-white transition-colors hover:bg-[#4a9fff] disabled:cursor-default disabled:opacity-40"
        disabled
      >Upload</button>
    </div>
  </div>
</div>
