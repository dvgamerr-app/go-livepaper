---
import { Upload } from '@lucide/astro'
---

<div id="storage-upload-modal" class="wails-no-drag fixed inset-0 z-[210] flex items-center justify-center bg-black/65" hidden>
  <div class="border-lp-border-strong w-[480px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]" role="dialog" aria-modal="true">
    <div class="px-5 pt-5 pb-3">
      <p class="text-lp-text mb-1 text-[13px] font-semibold" id="upload-modal-title">Upload Wallpaper</p>
      <p class="text-lp-muted text-[11px]">Select a file, fill in details, then click Upload.</p>
    </div>

    <div class="px-5 pb-3">
      <div id="upload-file-zone" class="border-lp-border flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed bg-white/[0.02] py-5 transition-colors hover:border-lp-accent hover:bg-lp-accent-soft">
        <Upload size={22} strokeWidth={1.5} class="text-lp-muted" aria-hidden="true" />
        <span class="text-lp-muted text-[12px]" id="upload-file-label">Click to choose file…</span>
      </div>
      <div id="upload-thumb-wrap" class="mt-3 hidden items-center gap-3">
        <img id="upload-thumb-img" class="h-16 w-28 rounded-md object-cover border border-lp-border" src="" alt="">
        <div>
          <p class="text-lp-text text-[11px] font-medium" id="upload-file-info">—</p>
          <p class="text-lp-muted text-[10px]" id="upload-thumb-note">Thumbnail auto-generated</p>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-3 px-5 pb-4">
      <div>
        <label class="text-lp-muted mb-1 block text-[10px] font-semibold uppercase tracking-wide">Title</label>
        <input id="upload-title" type="text" class="border-lp-border text-lp-text placeholder:text-lp-muted h-9 w-full rounded-md border bg-white/[0.04] px-3 text-[12px] outline-none focus:border-lp-accent/60" placeholder="Wallpaper title…">
      </div>
      <div>
        <label class="text-lp-muted mb-1 block text-[10px] font-semibold uppercase tracking-wide">Tier</label>
        <div class="flex gap-2" id="upload-tier-group">
          <button class="upload-tier-btn active" data-tier="free">Free</button>
          <button class="upload-tier-btn" data-tier="premium">Premium</button>
          <button class="upload-tier-btn" data-tier="top">Top</button>
        </div>
      </div>
      <div id="upload-progress-wrap" class="hidden">
        <div class="border-lp-border overflow-hidden rounded-full border bg-white/[0.04]" style="height:6px">
          <div id="upload-progress-bar" class="h-full rounded-full bg-lp-accent transition-all" style="width:0%"></div>
        </div>
        <p class="text-lp-muted mt-1 text-[10px]" id="upload-progress-label">Preparing…</p>
      </div>
    </div>

    <div class="border-lp-border flex items-center justify-end gap-2 border-t px-5 py-3">
      <button id="upload-cancel-btn" class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors hover:bg-white/[0.04]">Cancel</button>
      <button id="upload-submit-btn" class="cursor-pointer rounded-md bg-lp-accent px-4 py-1.5 text-[12px] font-semibold text-white transition-colors hover:bg-[#4a9fff] disabled:cursor-default disabled:opacity-50" disabled>Upload</button>
    </div>
  </div>
</div>
