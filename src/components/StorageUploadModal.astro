---
import { Plus } from '@lucide/astro'
import ModalShell from './ModalShell.astro'
---

<ModalShell
  id="storage-upload-modal"
  labelledBy="upload-modal-title"
  overlayClass="z-[210] bg-black/65"
  panelClass="flex max-h-[78vh] w-[520px] flex-col"
>
  <!-- Header -->
  <div class="shrink-0 px-5 pt-5 pb-3">
    <p class="text-lp-text mb-0.5 text-[13px] font-semibold" id="upload-modal-title">
      Upload Wallpapers
    </p>
    <p class="text-lp-muted text-[11px]">
      Select one or more images or videos. All items are set to <span
        class="text-lp-warn font-semibold">Premium</span
      > tier.
    </p>
  </div>

  <!-- Drop zone -->
  <div class="shrink-0 px-5 pb-3">
    <button
      id="upload-file-zone"
      type="button"
      class="border-lp-border hover:border-lp-accent hover:bg-lp-accent-soft flex w-full cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed bg-white/[0.02] py-5 transition-colors active:scale-[0.99]"
    >
      <Plus size={20} stroke-width={1.5} class="text-lp-muted" aria-hidden="true" />
      <div class="flex flex-col items-center gap-0.5">
        <span class="text-lp-text zone-label text-[12px] font-medium">Click to add files</span>
        <span class="text-lp-muted text-[10px]">Images &amp; videos — PNG, JPG, MP4, MKV…</span>
      </div>
    </button>
  </div>

  <!-- File list (shown once files are added) -->
  <div
    id="upload-file-list"
    class="upload-file-list lp-scroll hidden flex-1 overflow-y-auto px-5 pb-3"
  >
  </div>

  <!-- Overall progress (shown during upload) -->
  <div id="upload-progress-wrap" class="hidden shrink-0 px-5 pb-3">
    <div
      class="border-lp-border overflow-hidden rounded-full border bg-white/[0.04]"
      style="height:5px"
    >
      <div
        id="upload-progress-bar"
        class="bg-lp-accent h-full rounded-full transition-[width]"
        style="width:0%"
      >
      </div>
    </div>
    <p class="text-lp-muted mt-1.5 text-[10px]" id="upload-progress-label">Preparing…</p>
  </div>

  <!-- Footer actions -->
  <div class="border-lp-border flex shrink-0 items-center justify-end gap-2 border-t px-5 py-3">
    <button
      id="upload-cancel-btn"
      type="button"
      class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors hover:bg-white/[0.04]"
      >Cancel</button
    >
    <button
      id="upload-submit-btn"
      type="button"
      class="bg-lp-accent cursor-pointer rounded-md px-4 py-1.5 text-[12px] font-semibold text-white transition-colors hover:bg-[#4a9fff] disabled:cursor-default disabled:opacity-40"
      disabled>Upload</button
    >
  </div>
</ModalShell>
