---
import ViewHeader from './ViewHeader.astro'
---

<div id="library-panel" class="hidden flex-1 flex-col overflow-hidden">
  <ViewHeader title="Library" subtitle="Your downloaded wallpapers" subtitleId="library-count" />
  <div class="wails-no-drag lp-scroll flex-1 overflow-y-auto">
    <div class="p-3">
      <div id="library-grid">
        <div class="lib-empty">No wallpapers yet — download from Discover to add them here</div>
      </div>
    </div>
  </div>
</div>
