---
---
<div class="modal-overlay" id="settings-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-header">
      <span class="modal-title" id="modal-title">Settings</span>
      <button class="tb-btn" id="modal-close" aria-label="Close settings">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="modal-row">
        <div class="modal-row-text">
          <div class="modal-row-label">Version</div>
          <div class="modal-row-desc" id="modal-version">—</div>
        </div>
      </div>
      <div class="modal-divider"></div>
      <div class="modal-row">
        <div class="modal-row-text">
          <div class="modal-row-label">Temp folder</div>
          <div class="modal-row-desc">Encoded video files are cached in <code style="background:rgba(255,255,255,0.07);padding:1px 5px;border-radius:3px;font-size:10px">%TEMP%\livepaper\</code></div>
        </div>
      </div>
    </div>
  </div>
</div>
