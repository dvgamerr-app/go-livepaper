---
import { X, Trash2, RotateCcw } from '@lucide/astro'
---

<div
  class="wails-no-drag fixed inset-0 z-[100] flex items-center justify-center bg-black/60"
  id="settings-modal"
  hidden
>
  <div
    class="border-lp-border-strong w-[360px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div
      class="border-lp-border flex items-center justify-between border-b px-[18px] py-3.5 pr-3.5 pl-[18px]"
    >
      <span class="text-lp-text text-[13px] font-semibold" id="modal-title">Settings</span>
      <button
        class="text-lp-muted hover:text-lp-text grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-white/[0.06]"
        id="modal-close"
        aria-label="Close settings"
      >
        <X size={14} stroke-width={2} aria-hidden="true" />
      </button>
    </div>

    <div class="py-2">
      <div class="flex items-center justify-between gap-4 px-[18px] py-3">
        <div class="flex min-w-0 flex-col gap-0.5">
          <div class="text-lp-text text-[13px] font-medium">Version</div>
          <div class="text-lp-muted text-[11px] leading-tight" id="modal-version">—</div>
        </div>
      </div>

      <div class="bg-lp-border mx-[18px] h-px"></div>

      <div class="flex items-center justify-between gap-4 px-[18px] py-3">
        <div class="flex min-w-0 flex-col gap-0.5">
          <div class="text-lp-text text-[13px] font-medium">Temp folder</div>
          <div class="text-lp-muted text-[11px] leading-tight">
            Encoded video files are cached in <code class="code-inline">%TEMP%\livepaper\</code>
          </div>
        </div>
      </div>

      <div class="bg-lp-border mx-[18px] h-px"></div>

      <div class="flex items-center justify-between gap-4 px-[18px] py-3">
        <div class="flex min-w-0 flex-col gap-0.5">
          <div class="text-lp-text text-[13px] font-medium">Clean Cache</div>
          <div class="text-lp-muted text-[11px] leading-tight">
            Remove encoded video files from the temp folder
          </div>
        </div>
        <button
          class="text-lp-muted enabled:hover:text-lp-text inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border-0 bg-transparent px-3 text-xs font-medium whitespace-nowrap transition-colors duration-150 enabled:hover:bg-white/[0.05] disabled:cursor-not-allowed disabled:opacity-[0.35]"
          id="clean-btn"
        >
          <Trash2 size={13} stroke-width={2} aria-hidden="true" />
          Clean Cache
        </button>
      </div>

      <div class="flex items-center justify-between gap-4 px-[18px] py-3">
        <div class="flex min-w-0 flex-col gap-0.5">
          <div class="text-lp-text text-[13px] font-medium">Reset Wallpapers</div>
          <div class="text-lp-muted text-[11px] leading-tight">
            Remove all assigned wallpapers and restore defaults
          </div>
        </div>
        <button
          class="text-lp-muted enabled:hover:text-lp-danger inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 text-xs font-medium whitespace-nowrap transition-[color,background-color,border-color] duration-150 enabled:hover:border-[rgba(255,85,85,0.3)] enabled:hover:bg-[rgba(255,85,85,0.06)] disabled:cursor-not-allowed disabled:opacity-[0.35]"
          id="reset-btn"
          disabled
        >
          <RotateCcw size={13} stroke-width={2} aria-hidden="true" />
          Reset
        </button>
      </div>
    </div>
  </div>
</div>
