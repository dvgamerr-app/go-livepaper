---
// Full tabbed Settings panel. Markup only — all behavior is wired in the inline
// module script in index.astro via [data-setting] / [data-hotkey] / [data-stab].
const tabs = [
  { id: 'general', label: 'General' },
  { id: 'performance', label: 'Performance' },
  { id: 'startup', label: 'Startup' },
  { id: 'hotkeys', label: 'Hotkeys' },
  { id: 'connections', label: 'Connections' },
  { id: 'billing', label: 'Billing' },
  { id: 'about', label: 'About' },
]

const freeFeatures = [
  'Multi-monitor wallpapers',
  'Image, GIF & video wallpapers',
  'Unlimited local library & gallery',
  'Global hotkeys & window themes',
  'Hardware decoding & power-saving',
]
const communityFeatures = [
  'Everything in Free, unlimited',
  'One-click apply community wallpapers',
  'New community packs & creators',
  'Priority workshop downloads',
]
---

<div id="settings-panel" class="hidden flex-1 flex-col overflow-hidden">
  <!-- Top bar -->
  <div class="border-lp-border wails-drag flex h-[52px] shrink-0 items-center gap-3 border-b px-4">
    <button
      id="settings-back-btn"
      class="wails-no-drag text-lp-muted hover:text-lp-text grid h-9 w-9 shrink-0 cursor-pointer place-items-center rounded border-0 bg-transparent transition-colors duration-[120ms] hover:bg-white/[0.06]"
      aria-label="Back to displays"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <div class="wails-drag">
      <h1 class="text-sm font-semibold tracking-[-0.01em]">Settings</h1>
      <p class="text-lp-muted mt-px text-[11px]">
        Fine-tune the engine, hotkeys, and startup behavior
      </p>
    </div>
  </div>

  <div class="wails-no-drag flex flex-1 overflow-hidden">
    <!-- Tabs -->
    <nav
      class="border-lp-border bg-lp-surface/30 flex w-44 shrink-0 flex-col gap-0.5 border-r p-3"
      aria-label="Settings sections"
    >
      {
        tabs.map((t, i) => (
          <button
            class={`settings-tab flex h-9 w-full cursor-pointer items-center gap-2.5 rounded-md border-0 px-3 text-left text-[12.5px] font-medium transition-colors ${i === 0 ? 'bg-lp-accent-soft text-lp-text' : 'text-lp-muted hover:text-lp-text bg-transparent hover:bg-white/[0.04]'}`}
            data-stab={t.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {t.label}
            <span
              class="dot bg-lp-accent ml-auto h-1.5 w-1.5 rounded-full"
              style={i === 0 ? '' : 'display:none'}
            />
          </button>
        ))
      }
    </nav>

    <!-- Panels -->
    <div class="lp-scroll max-w-3xl flex-1 overflow-y-auto p-6">
      <!-- ── General ── -->
      <section data-spanel="general">
        <h3 class="setting-section-title">General</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Language</p>
              <p class="setting-desc">Interface language.</p>
            </div>
            <div class="lp-select" data-setting="language" aria-label="Interface language">
              <button type="button" class="lp-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="lp-select-val">English (US)</span>
                <svg class="lp-select-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="lp-select-dropdown" role="listbox" hidden>
                <button type="button" class="lp-select-item selected" data-value="en-US" role="option" aria-selected="true">English (US)</button>
              </div>
            </div>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Telemetry</p>
              <p class="setting-desc">Share anonymized usage to improve Live Paper.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="telemetry"
              class="lp-toggle"
              aria-label="Telemetry"><span class="lp-toggle-knob"></span></button
            >
          </div>
        </div>

        <h3 class="setting-section-title mt-6">Storage</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Temp folder</p>
              <p class="setting-desc">
                Encoded video files are cached in <code class="setting-code">%TEMP%\livepaper\</code
                >
              </p>
            </div>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Clean cache</p>
              <p class="setting-desc">Remove encoded video files from the temp folder.</p>
            </div>
            <button
              class="text-lp-muted enabled:hover:text-lp-text inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.08] bg-transparent px-3 text-xs font-medium whitespace-nowrap transition-colors duration-150 enabled:hover:bg-white/[0.05] disabled:cursor-not-allowed disabled:opacity-[0.35]"
              id="clean-btn"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"
                ></path>
              </svg>
              Clean Cache
            </button>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Reset wallpapers</p>
              <p class="setting-desc">Remove all assigned wallpapers and restore defaults.</p>
            </div>
            <button
              class="text-lp-muted enabled:hover:text-lp-danger inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 text-xs font-medium whitespace-nowrap transition-[color,background-color,border-color] duration-150 enabled:hover:border-[rgba(255,85,85,0.3)] enabled:hover:bg-[rgba(255,85,85,0.06)] disabled:cursor-not-allowed disabled:opacity-[0.35]"
              id="reset-btn"
              disabled
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path
                  d="M3 3v5h5"></path>
              </svg>
              Reset
            </button>
          </div>
        </div>
      </section>

      <!-- ── Performance ── -->
      <section data-spanel="performance" hidden>
        <h3 class="setting-section-title">Rendering</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Hardware decoding</p>
              <p class="setting-desc">Use GPU to decode video. Disabling uses CPU decoding with lighter GPU rendering.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="gpuAcceleration"
              class="lp-toggle"
              aria-label="Hardware decoding"><span class="lp-toggle-knob"></span></button
            >
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Memory cap</p>
              <p class="setting-desc">Limit the RAM read-ahead buffer used by the video stream.</p>
            </div>
            <div class="flex w-56 items-center gap-3">
              <input
                type="range"
                min="64"
                max="1024"
                step="32"
                data-setting="vramCapMB"
                class="accent-lp-accent flex-1"
                aria-label="Memory cap in megabytes"
              />
              <span class="text-lp-muted w-16 text-right font-mono text-[11px]" id="vram-cap-label"
                >256 MB</span
              >
            </div>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Render adapter</p>
              <p class="setting-desc">Choose which GPU renders live wallpapers.</p>
            </div>
            <div class="lp-select" data-setting="gpuAdapter" id="gpu-adapter-select" aria-label="Render adapter">
              <button type="button" class="lp-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="lp-select-val">Auto</span>
                <svg class="lp-select-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="lp-select-dropdown" role="listbox" hidden>
                <button type="button" class="lp-select-item selected" data-value="" role="option" aria-selected="true">Auto</button>
              </div>
            </div>
          </div>
        </div>

        <h3 class="setting-section-title mt-6">Behavior</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Pause on game detection</p>
              <p class="setting-desc">Pause playback when a fullscreen app is in focus.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="pauseOnGame"
              class="lp-toggle"
              aria-label="Pause on game detection"><span class="lp-toggle-knob"></span></button
            >
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Pause on battery saver</p>
              <p class="setting-desc">Stop video playback when Windows enters battery saver.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="pauseOnBattery"
              class="lp-toggle"
              aria-label="Pause on battery saver"><span class="lp-toggle-knob"></span></button
            >
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Reduce motion on focus</p>
              <p class="setting-desc">Slow playback while another app is in the foreground.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="reduceMotionOnFocus"
              class="lp-toggle"
              aria-label="Reduce motion on focus"><span class="lp-toggle-knob"></span></button
            >
          </div>
        </div>

        <h3 class="setting-section-title mt-6">Appearance</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Window theme</p>
              <p class="setting-desc">Background material for the Live Paper window.</p>
            </div>
            <div class="flex gap-1.5" role="group" aria-label="Window theme">
              <button type="button" class="theme-card" data-setting="windowTheme" data-value="mica">Warm</button>
              <button type="button" class="theme-card" data-setting="windowTheme" data-value="acrylic">Acrylic</button>
              <button type="button" class="theme-card" data-setting="windowTheme" data-value="solid">Solid</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Startup ── -->
      <section data-spanel="startup" hidden>
        <h3 class="setting-section-title">Startup</h3>
        <div class="setting-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Launch at login</p>
              <p class="setting-desc">Start Live Paper when Windows boots.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="launchAtLogin"
              class="lp-toggle"
              aria-label="Launch at login"><span class="lp-toggle-knob"></span></button
            >
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Start minimized to tray</p>
              <p class="setting-desc">Hide the window on launch and run from the tray.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="startMinimized"
              class="lp-toggle"
              aria-label="Start minimized to tray"><span class="lp-toggle-knob"></span></button
            >
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Restore last wallpapers</p>
              <p class="setting-desc">Re-apply the last active wallpapers on launch.</p>
            </div>
            <button
              type="button"
              role="switch"
              aria-checked="false"
              data-setting="restoreLastPlaylist"
              class="lp-toggle"
              aria-label="Restore last wallpapers"><span class="lp-toggle-knob"></span></button
            >
          </div>
        </div>
      </section>

      <!-- ── Hotkeys ── -->
      <section data-spanel="hotkeys" hidden>
        <h3 class="setting-section-title">Global hotkeys</h3>
        <p class="text-lp-muted mb-3 text-[11px]">
          Click a shortcut to rebind it. Hotkeys work while Live Paper is running.
        </p>
        <div class="setting-group" id="hotkeys-group">
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Next wallpaper</p>
              <p class="setting-desc">Cycle the gallery forward onto the primary display.</p>
            </div>
            <button type="button" class="lp-kbd" data-hotkey="next">—</button>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Previous wallpaper</p>
              <p class="setting-desc">Cycle the gallery backward onto the primary display.</p>
            </div>
            <button type="button" class="lp-kbd" data-hotkey="prev">—</button>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Pause / Resume</p>
              <p class="setting-desc">Toggle playback of all video wallpapers.</p>
            </div>
            <button type="button" class="lp-kbd" data-hotkey="playpause">—</button>
          </div>
          <div class="setting-item">
            <div class="min-w-0">
              <p class="setting-label">Open Live Paper</p>
              <p class="setting-desc">Bring the Live Paper window to the front.</p>
            </div>
            <button type="button" class="lp-kbd" data-hotkey="open">—</button>
          </div>
        </div>
      </section>

      <!-- ── Connections ── -->
      <section data-spanel="connections" hidden>
        <!-- Signed out -->
        <div
          id="connections-signin"
          class="border-lp-border bg-lp-surface/40 hidden flex-col items-center gap-4 rounded-xl border p-10 text-center"
        >
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/[0.06]">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="rgba(255,255,255,0.7)"
              aria-hidden="true"
              ><path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path></svg
            >
          </span>
          <div>
            <p class="text-lp-text text-[14px] font-semibold">Sign in to manage connections</p>
            <p class="text-lp-muted mt-1 text-[12px]">
              Link a GitHub account to unlock the star discount.
            </p>
          </div>
          <button
            id="connections-signin-btn"
            class="bg-lp-accent inline-flex h-11 cursor-pointer items-center gap-2 rounded-md px-6 text-[13px] font-semibold text-white transition-colors hover:bg-[#4a9fff]"
          >
            Sign in
          </button>
        </div>

        <!-- Signed in -->
        <div id="connections-content" class="hidden">
          <h3 class="setting-section-title">Linked accounts</h3>
          <div class="setting-group">
            <div class="setting-item">
              <div class="flex min-w-0 items-center gap-3">
                <span
                  class="text-lp-text grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/[0.06]"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    ><path
                      d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                    ></path></svg
                  >
                </span>
                <div class="min-w-0">
                  <p class="setting-label">GitHub</p>
                  <p class="setting-desc" id="gh-status">Checking…</p>
                </div>
              </div>
              <button
                id="gh-connect-btn"
                class="text-lp-text inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.12] bg-white/[0.04] px-3 text-[12px] font-medium transition-colors hover:bg-white/[0.08]"
              >
                Connect GitHub
              </button>
            </div>
            <div class="setting-item">
              <div class="min-w-0">
                <p class="setting-label">Repo star</p>
                <p class="setting-desc" id="conn-star-status">Checking…</p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <button
                  id="conn-star-btn"
                  class="text-lp-text inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.12] bg-white/[0.04] px-3 text-[12px] font-medium transition-colors hover:bg-white/[0.08]"
                >
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    ><polygon
                      points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                    ></polygon></svg
                  >
                  Star on GitHub
                </button>
                <button
                  id="conn-recheck-btn"
                  class="text-lp-muted hover:text-lp-text inline-flex h-9 cursor-pointer items-center rounded-md border-0 bg-transparent px-2 text-[12px] transition-colors hover:bg-white/[0.05]"
                  >Re-check</button
                >
              </div>
            </div>
          </div>
          <p class="text-lp-muted mt-3 text-[11px] leading-snug">
            Starring <span class="font-mono" id="conn-repo">dvgamerr/go-livepaper</span> drops community
            access from $9 to $4/mo.
          </p>
        </div>
      </section>

      <!-- ── Billing ── -->
      <section data-spanel="billing" hidden>
        <!-- Not signed in -->
        <div
          id="billing-signin"
          class="border-lp-border bg-lp-surface/40 hidden flex-col items-center gap-4 rounded-xl border p-10 text-center"
        >
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/[0.06]">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="rgba(255,255,255,0.7)"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
                d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
            >
          </span>
          <div>
            <p class="text-lp-text text-[14px] font-semibold">Sign in to subscribe</p>
            <p class="text-lp-muted mt-1 text-[12px]">
              A free account links your subscription and unlocks the GitHub-star discount.
            </p>
          </div>
          <button
            id="billing-signin-btn"
            class="bg-lp-accent inline-flex h-11 cursor-pointer items-center gap-2 rounded-md px-6 text-[13px] font-semibold text-white transition-colors hover:bg-[#4a9fff]"
          >
            Sign in
          </button>
        </div>

        <!-- Active subscription -->
        <div id="billing-active" class="hidden">
          <div
            class="rounded-xl border border-[rgba(52,211,153,0.3)] bg-[rgba(52,211,153,0.07)] p-6"
          >
            <div class="flex items-center gap-2.5">
              <span class="bg-lp-success grid h-6 w-6 place-items-center rounded-full text-black">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg
                >
              </span>
              <h2 class="text-[15px] font-semibold">Community access active</h2>
            </div>
            <p class="text-lp-muted mt-2 text-[12px]">
              <span id="billing-active-plan">Monthly</span> · <span id="billing-active-price"
                >$9</span
              >/mo · renews <span id="billing-active-renew">—</span>
            </p>
            <p id="billing-active-starred" class="text-lp-success mt-1 hidden text-[11px]">
              ★ GitHub-star discount applied
            </p>
            <button
              id="billing-cancel-btn"
              class="text-lp-muted hover:text-lp-danger mt-4 inline-flex h-9 cursor-pointer items-center rounded-md border border-white/[0.1] bg-transparent px-4 text-[12px] font-medium transition-colors hover:border-[rgba(255,85,85,0.3)] hover:bg-[rgba(255,85,85,0.06)]"
            >
              Cancel subscription
            </button>
          </div>
        </div>

        <!-- Free / upsell -->
        <div id="billing-free" class="hidden">
          <div
