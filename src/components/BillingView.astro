---
// Subscription / billing page. Three states (sign-in, free, active) are toggled
// by the inline script in index.astro. Pricing reflects the GitHub-star
// discount fetched from the backend.
const freeFeatures = [
  'Multi-monitor wallpapers',
  'Image, GIF & video wallpapers',
  'Unlimited local library & gallery',
  'Global hotkeys & window themes',
  'GPU acceleration & power-saving',
]
const communityFeatures = [
  'Everything in Free, unlimited',
  'One-click apply community wallpapers',
  'New community packs & creators',
  'Priority workshop downloads',
]
---

<div id="billing-panel" class="hidden flex-1 flex-col overflow-hidden">
  <!-- Header -->
  <div class="border-lp-border wails-drag flex h-[52px] shrink-0 items-center border-b px-6">
    <div class="wails-drag">
      <h1 class="text-sm leading-tight font-semibold tracking-[-0.01em]">Billing</h1>
      <p class="text-lp-muted mt-px text-[11px]">Manage your community access subscription</p>
    </div>
  </div>

  <div class="wails-no-drag lp-scroll flex-1 overflow-y-auto px-6 py-6">
    <div class="mx-auto max-w-2xl">
      <!-- ── Not signed in ── -->
      <div
        id="billing-signin"
        class="border-lp-border bg-lp-surface/40 hidden flex-col items-center gap-4 rounded-xl border p-10 text-center"
      >
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/[0.06]">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="rgba(255,255,255,0.7)"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
              d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
          >
        </span>
        <div>
          <p class="text-lp-text text-[14px] font-semibold">Sign in to subscribe</p>
          <p class="text-lp-muted mt-1 text-[12px]">
            A free account links your subscription and unlocks the GitHub-star discount.
          </p>
        </div>
        <button
          id="billing-signin-btn"
          class="bg-lp-accent inline-flex h-11 cursor-pointer items-center gap-2 rounded-md px-6 text-[13px] font-semibold text-white transition-colors hover:bg-[#4a9fff]"
        >
          Sign in
        </button>
      </div>

      <!-- ── Active subscription ── -->
      <div id="billing-active" class="hidden">
        <div class="rounded-xl border border-[rgba(52,211,153,0.3)] bg-[rgba(52,211,153,0.07)] p-6">
          <div class="flex items-center gap-2.5">
            <span class="bg-lp-success grid h-6 w-6 place-items-center rounded-full text-black">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </span>
            <h2 class="text-[15px] font-semibold">Community access active</h2>
          </div>
          <p class="text-lp-muted mt-2 text-[12px]">
            <span id="billing-active-plan">Monthly</span> · <span id="billing-active-price">$9</span
            >/mo · renews <span id="billing-active-renew">—</span>
          </p>
          <p id="billing-active-starred" class="text-lp-success mt-1 hidden text-[11px]">
            ★ GitHub-star discount applied
          </p>
          <button
            id="billing-cancel-btn"
            class="text-lp-muted hover:text-lp-danger mt-4 inline-flex h-9 cursor-pointer items-center rounded-md border border-white/[0.1] bg-transparent px-4 text-[12px] font-medium transition-colors hover:border-[rgba(255,85,85,0.3)] hover:bg-[rgba(255,85,85,0.06)]"
          >
            Cancel subscription
          </button>
        </div>
        <div class="mt-5">
          <p class="setting-section-title">Included</p>
          <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {
              communityFeatures.map((f) => (
                <li class="text-lp-text flex items-center gap-2 text-[12px]">
                  <svg
                    class="text-lp-success shrink-0"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- ── Free / upsell ── -->
      <div id="billing-free" class="hidden">
        <!-- Star discount banner -->
        <div
          class="border-lp-border bg-lp-surface/40 mb-5 flex flex-col gap-3 rounded-xl border p-5 sm:flex-row sm:items-center"
        >
          <span
            class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-[rgba(250,204,21,0.14)] text-[#facc15]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon></svg
            >
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-lp-text text-[12.5px] font-semibold">Star the repo, save $5/mo</p>
            <p class="text-lp-muted text-[11px] leading-snug" id="billing-star-status">
              Star <span class="font-mono" id="billing-repo">dvgamerr/go-livepaper</span> on GitHub to
              drop the price from $9 to $4.
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <button
              id="billing-star-btn"
              class="text-lp-text inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-white/[0.12] bg-white/[0.04] px-3 text-[12px] font-medium transition-colors hover:bg-white/[0.08]"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><polygon
                  points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                ></polygon></svg
              >
              Star on GitHub
            </button>
            <button
              id="billing-recheck-btn"
              class="text-lp-muted hover:text-lp-text inline-flex h-9 cursor-pointer items-center rounded-md border-0 bg-transparent px-2 text-[12px] transition-colors hover:bg-white/[0.05]"
              >Re-check</button
            >
          </div>
        </div>

        <!-- Plan comparison -->
        <div class="grid gap-4 sm:grid-cols-2">
          <!-- Free -->
          <div class="border-lp-border bg-lp-surface/40 rounded-xl border p-5">
            <div class="flex items-baseline justify-between">
              <h3 class="text-[14px] font-semibold">Free</h3>
              <span
                class="text-lp-muted rounded bg-white/[0.06] px-2 py-0.5 text-[10px] font-medium"
                id="billing-free-badge">Current</span
              >
            </div>
            <p class="mt-2 text-[26px] font-bold tracking-tight">
              $0<span class="text-lp-muted text-[12px] font-medium">/forever</span>
            </p>
            <p class="text-lp-muted mt-1 text-[11px]">All local features, no limits.</p>
            <ul class="mt-4 flex flex-col gap-2">
              {
                freeFeatures.map((f) => (
                  <li class="text-lp-text flex items-center gap-2 text-[12px]">
                    <svg
                      class="text-lp-success shrink-0"
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {f}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Community (highlighted) -->
          <div
            class="border-lp-accent/40 relative rounded-xl border bg-[rgba(47,138,239,0.06)] p-5 shadow-[0_20px_50px_-25px_rgba(47,138,239,0.6)]"
          >
            <span
              class="bg-lp-accent absolute -top-2.5 left-5 rounded px-2 py-0.5 text-[9px] font-bold tracking-wide text-white uppercase"
              >Recommended</span
            >
            <div class="flex items-baseline justify-between">
              <h3 class="text-[14px] font-semibold">Community</h3>
            </div>
            <p class="mt-2 flex items-baseline gap-2">
              <span class="text-[26px] font-bold tracking-tight"
                ><span id="billing-price">$9</span><span
                  class="text-lp-muted text-[12px] font-medium">/mo</span
                ></span
              >
              <span
                id="billing-price-strike"
                class="text-lp-muted hidden text-[14px] font-medium line-through">$9</span
              >
            </p>
            <p class="text-lp-muted mt-1 text-[11px]" id="billing-price-note">
              Apply any community wallpaper.
            </p>
            <ul class="mt-4 flex flex-col gap-2">
              {
                communityFeatures.map((f) => (
                  <li class="text-lp-text flex items-center gap-2 text-[12px]">
                    <svg
                      class="text-lp-accent shrink-0"
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {f}
                  </li>
                ))
              }
            </ul>
            <button
              id="billing-subscribe-btn"
              class="bg-lp-accent mt-5 inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-md text-[13px] font-semibold text-white transition-colors hover:bg-[#4a9fff] disabled:cursor-not-allowed disabled:opacity-50"
            >
              Subscribe for <span id="billing-subscribe-price">$9</span>/mo
            </button>
            <p
              class="text-lp-muted mt-3 flex items-center justify-center gap-1.5 text-center text-[10px]"
            >
              <svg
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path
                  d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
              >
              Secure checkout · Cancel anytime
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
