---
import { X, Lock, CircleAlert } from '@lucide/astro'
---

<div
  id="login-modal"
  hidden
  class="fixed inset-0 z-50 flex items-end justify-center bg-black/50 backdrop-blur-[3px] sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="login-modal-title"
>
  <div
    id="login-modal-box"
    class="border-lp-border relative w-full max-w-[360px] rounded-2xl border bg-[rgba(16,16,20,0.98)] p-6 pb-5 shadow-[0_32px_80px_rgba(0,0,0,0.7)] backdrop-blur-[32px]"
  >
    <!-- Close -->
    <button
      id="login-modal-close"
      aria-label="Close sign-in"
      class="absolute top-4 right-4 flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-white/25 transition-colors duration-100 hover:bg-white/[0.07] hover:text-white/60"
    >
      <X size={13} stroke-width={2.5} aria-hidden="true" />
    </button>

    <!-- Header -->
    <div class="mb-5 pr-6">
      <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-white/[0.06]">
        <Lock size={18} color="rgba(255,255,255,0.7)" stroke-width={1.75} aria-hidden="true" />
      </div>
      <h2 id="login-modal-title" class="text-[15px] font-semibold tracking-[-0.01em]">
        Sign in to LivePaper
      </h2>
      <p class="text-lp-muted mt-1 text-[12px] leading-snug">
        Your browser will open to complete sign-in securely.
      </p>
    </div>

    <!-- Default state: SSO buttons -->
    <div id="sso-buttons" class="flex flex-col gap-2.5">
      <button id="sso-github" class="sso-btn" data-provider="github" type="button">
        <svg class="sso-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"
          ></path>
        </svg>
        Continue with GitHub
      </button>

      <button id="sso-google" class="sso-btn" data-provider="google" type="button">
        <svg class="sso-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        Continue with Google
      </button>
    </div>

    <!-- Waiting state (hidden by default) -->
    <div id="sso-waiting-state" class="hidden flex-col items-center gap-3 py-2 text-center">
      <div class="sso-spinner" aria-hidden="true"></div>
      <div>
        <p class="text-[13px] font-medium text-white/80" id="sso-waiting-label">
          Waiting for browser…
        </p>
        <p class="text-lp-muted mt-0.5 text-[11px]">
          Complete sign-in in your browser, then return here.
        </p>
      </div>
      <button
        id="sso-cancel"
        type="button"
        class="mt-1 h-8 cursor-pointer rounded-lg border border-white/[0.08] bg-transparent px-4 text-[11px] font-medium text-white/40 transition-colors hover:border-white/[0.14] hover:text-white/60"
        >Cancel</button
      >
    </div>

    <!-- Error (inline, shown below buttons) -->
    <p id="sso-error" class="mt-3 hidden items-center gap-1.5 text-[11px] text-red-400">
      <CircleAlert size={12} stroke-width={2.5} class="shrink-0" aria-hidden="true" />
      <span id="sso-error-text"></span>
    </p>

    <!-- Trust note -->
    <p class="text-lp-muted mt-5 text-center text-[10px] leading-relaxed">
      By signing in you agree to our&nbsp;<a
        href="#"
        class="underline underline-offset-2 hover:text-white/60">Terms</a
      >&nbsp;and&nbsp;<a href="#" class="underline underline-offset-2 hover:text-white/60"
        >Privacy Policy</a
      >.
    </p>
  </div>
</div>

<style>
  .sso-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 44px; /* Fitts's Law: ≥ 44px */
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 120ms,
      border-color 120ms,
      color 120ms;
    text-align: left;
  }
  .sso-btn:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.16);
    color: #fff;
  }
  .sso-btn:active {
    background: rgba(255, 255, 255, 0.1);
  }
  .sso-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .sso-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
  .sso-spinner {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2.5px solid rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.55);
    animation: spin 700ms linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
