---

---

<div
  id="monitor-picker-modal"
  class="wails-no-drag fixed inset-0 z-[200] flex items-center justify-center bg-black/60"
  hidden
>
  <div
    class="border-lp-border-strong w-[520px] overflow-hidden rounded-xl border bg-[#18181b] shadow-[0_24px_64px_rgba(0,0,0,0.7)]"
    role="dialog"
    aria-modal="true"
  >
    <div class="px-5 pt-5 pb-3">
      <p class="text-lp-text mb-1 text-[13px] font-semibold">Select Monitor</p>
      <p class="text-lp-muted text-[11px] leading-relaxed">Choose which monitor to apply this wallpaper to. Hover to preview.</p>
    </div>
    <div id="monitor-picker-grid" class="flex gap-3 px-5 pb-4">
      <!-- populated by JS -->
    </div>
    <div class="border-lp-border flex items-center justify-end gap-2 border-t px-5 py-3">
      <button
        id="monitor-picker-cancel"
        class="text-lp-muted hover:text-lp-text cursor-pointer rounded-md border border-white/[0.08] bg-transparent px-3 py-1.5 text-[12px] transition-colors duration-[120ms] hover:bg-white/[0.04]"
      >
        Cancel
      </button>
    </div>
  </div>
</div>
